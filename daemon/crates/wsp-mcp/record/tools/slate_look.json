      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "description": "another thread's id"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "theme": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "width",
        "height",
        "theme",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "anthropic/alwaysLoad": true
    }
  },

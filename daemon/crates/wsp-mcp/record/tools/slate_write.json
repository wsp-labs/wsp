{
  "cloudOff": {
    "name": "slate_write",
    "description": "Writes this thread's slate. The slate is the person's visual companion while you work: words stay in the chat, and your reply never restates it. Show what they want to see (live data, traffic, metrics, a price, a PR, progress), a dashboard, a form to fill in or a decision. A run with every= refreshes; never poll in chat. A run's script goes in a <file name=\"x.py\">, run as python3 \"$SLATE_DIR/x.py\", never in the project.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "thread": {
          "type": "string",
          "description": "another thread's id"
        },
        "text": {
          "type": "string",
          "description": "JSX-like text: a <slate>, or a patch"
        },
        "document": {
          "type": "object",
          "additionalProperties": {},
          "description": "JSON form from slate_read; not for writing"
        },
        "check": {
          "type": "boolean",
          "description": "validate, write nothing"
        },
        "values": {
          "type": "object",
          "additionalProperties": {},
          "description": "with check: $path: value"
        },
        "press": {
          "type": "string",
          "description": "with check: piece id to press"
        },
        "row": {
          "type": "integer",
          "description": "pressed row, from 0"
        },
        "action": {
          "type": "integer",
          "description": "row action, from 0"
        },
        "if_version": {
          "type": "integer",
          "description": "only at this version"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "warnings": {},
        "problems": {},
        "waiting": {}
      },
      "required": [
        "version",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "anthropic/alwaysLoad": true
    }
  },

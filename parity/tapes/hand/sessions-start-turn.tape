{"meta":{"door":"ws","source":"hand: a turn starts against a stand-in claude the tape sets up, answers and ends","outs":"recorded","computer":"ip-172-31-43-224"}}
{"in":{"id":1,"op":"auth","token":"<host-token>"}}
{"in":{"id":2,"op":"projects.add","source":"<run>"}}
{"out":{"id":2,"ok":true,"project":{"id":"<project>"}}}
{"in":{"id":3,"op":"agents.setup","placeId":"here","agent":"claude","program":"/bin/sh","args":["-c","all=\" $0 $* \"\ncase \"$all\" in\n  *\" --version \"*) echo \"2.1.300 (Claude Code)\"; exit 0 ;;\n  *\" --help \"*) echo '--permission-mode <mode>  (choices: \"default\", \"bypassPermissions\")'; exit 0 ;;\n  *\" --bare \"*) read -r _; echo '{\"type\":\"control_response\",\"response\":{\"subtype\":\"success\",\"request_id\":\"init\",\"response\":{\"models\":[{\"value\":\"default\",\"resolvedModel\":\"claude-haiku-5-5\"},{\"value\":\"claude-haiku-5-5\",\"displayName\":\"Haiku\",\"supportedEffortLevels\":[\"low\",\"high\"]}]}}}'; exit 0 ;;\n  *\" --input-format stream-json \"*) ;;\n  *) exit 1 ;;\nesac\nsession=\"\"; prev=\"\"\nfor a in \"$0\" \"$@\"; do [ \"$prev\" = \"--session-id\" ] && session=$a; prev=$a; done\nwhile IFS= read -r _; do\n  printf '{\"type\":\"system\",\"subtype\":\"init\",\"session_id\":\"%s\",\"model\":\"claude-haiku-5-5\",\"cwd\":\"/\",\"tools\":[]}\\n' \"$session\"\n  printf '{\"type\":\"assistant\",\"session_id\":\"%s\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"ok\"}]}}\\n' \"$session\"\n  printf '{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"ok\",\"session_id\":\"%s\"}\\n' \"$session\"\ndone\n"]}}
{"in":{"id":4,"op":"events.subscribe"}}
{"in":{"id":5,"op":"sessions.start","project":"<project>","prompt":"hi","harness":"claude"}}

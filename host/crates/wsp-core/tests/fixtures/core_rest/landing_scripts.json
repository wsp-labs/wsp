 "unsavedScript": "[ -d '/srv/it'\\''s here' ] || { echo wsp-no-checkout; exit 0; }\ncommand -v git >/dev/null 2>&1 || exit 1\n[ -L '/srv/it'\\''s here'/.git ] && [ ! -e '/srv/it'\\''s here'/.git ] && exit 1\nif [ -e '/srv/it'\\''s here'/.git ] || [ -L '/srv/it'\\''s here'/.git ]; then git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C '/srv/it'\\''s here' rev-parse --git-dir >/dev/null 2>&1 || exit 1;\nelse git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C '/srv/it'\\''s here' rev-parse --git-dir >/dev/null 2>&1 || { echo wsp-no-checkout; exit 0; }; fi\ntrees=$(git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C '/srv/it'\\''s here' worktree list --porcelain) || exit 1\nheads=$(printf '%s\\n' \"$trees\" | sed -n 's/^HEAD //p' | grep -v '^0*$')\nahead=$(git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C '/srv/it'\\''s here' rev-list --count --branches $heads --not --remotes '--glob=refs/wsp/seeded/*') || exit 1\nchanged=0\ntree=\nwhile IFS= read -r line; do\n  case $line in\n    \"worktree \"*) tree=${line#worktree } ;;\n    bare) tree= ;;\n    \"\")\n      if [ -n \"$tree\" ] && [ -d \"$tree\" ]; then\n        said=$(git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C \"$tree\" status --porcelain -- ':(top,exclude).pnpm-store') || exit 1\n        [ -z \"$said\" ] || changed=$((changed + $(printf '%s\\n' \"$said\" | wc -l)))\n      fi\n      tree= ;;\n  esac\ndone <<WSP_TREES\n$trees\n\nWSP_TREES\nstashed=$(git -c safe.directory='*' -c core.fsmonitor=false --no-optional-locks -C '/srv/it'\\''s here' stash list) || exit 1\nstashes=0\n[ -z \"$stashed\" ] || stashes=$(($(printf '%s\\n' \"$stashed\" | wc -l)))\necho \"$ahead $changed $stashes\"",

{
 "parse_dpkg_fields": [
  {
   "name": "JavaScript whitespace: U+0085 is not a separator, U+00A0 U+FEFF U+2028 are",
   "args": [
    "ab\nc d\ne﻿ f\ng h\n"
   ],
   "out": [
    [
     "c",
     "d"
    ],
    [
     "e",
     "f"
    ],
    [
     "g",
     "h"
    ]
   ]
  },
  {
   "name": "tab and runs of spaces split, a leading space or a third field drops the line, trailing space and CR are fine",
   "args": [
    "a \t b  \nx  y z\n  lead v\nq w \r\n"
   ],
   "out": [
    [
     "a",
     "b"
    ],
    [
     "q",
     "w"
    ]
   ]
  },
  {
   "name": "empty text",
   "args": [
    ""
   ],
   "out": []
  }
 ],
 "parse_apt_manual": [
  {
   "name": "JavaScript trim: BOM and NBSP go, blank lines go, repeats stay",
   "args": [
    "﻿a \n \t\n b \r\n\nc\nc\n"
   ],
   "out": [
    "a",
    "b",
    "c",
    "c"
   ]
  },
  {
   "name": "empty text",
   "args": [
    ""
   ],
   "out": []
  }
 ],
 "apt_packages": [
  {
   "name": "command path table and the priority filter",
   "laptop": {
    "platform": "linux",
    "which": [
     "apt-mark",
     "dpkg-query"
    ],
    "files": {
     "/var/lib/dpkg/info/a.list": "/usr/bin/\n/usr/bin/a/b\n/usr/sbin/a\n",
     "/var/lib/dpkg/info/b.list": "/bin/b c\n",
     "/var/lib/dpkg/info/c.list": "  /usr/bin/c\r\n",
     "/var/lib/dpkg/info/d.list": "",
     "/var/lib/dpkg/info/e.list": "/usr/local/bin/e\n/sbin/e\n/usr/bin\n",
     "/var/lib/dpkg/info/f.list": "x\n/usr/bin/f",
     "/var/lib/dpkg/info/g.list": "/usr/bin/g\n",
     "/var/lib/dpkg/info/h.list": "/usr/bin/h\n",
     "/var/lib/dpkg/info/i.list": "/usr/bin/i\n"
    },
    "exec": {
     "apt-mark showmanual": "a\nb\nc\nd\ne\nf\ng\nh\ni\n",
     "dpkg-query -Wf ${Package} ${Priority}\n": "a optional\nb extra\nc optional\nd optional\ne optional\nf optional\ng Optional\nh standard\ni optional extra\n"
    }
   },
   "args": [],
   "out": [
    {
     "name": "b"
    },
    {
     "name": "c"
    },
    {
     "name": "f"
    }
   ],
   "calls": [
    "run apt-mark showmanual",
    "run dpkg-query -Wf ${Package} ${Priority}\n",
    "lines /var/lib/dpkg/info/a.list",
    "lines /var/lib/dpkg/info/b.list",
    "lines /var/lib/dpkg/info/c.list",
    "lines /var/lib/dpkg/info/d.list",
    "lines /var/lib/dpkg/info/e.list",
    "lines /var/lib/dpkg/info/f.list"
   ]
  },
  {
   "name": "package name from the list file name",
   "laptop": {
    "platform": "linux",
    "which": [
     "apt-mark",
     "dpkg-query"
    ],
    "files": {
     "/var/lib/dpkg/info/:amd64.list": "/usr/bin/nameless\n",
     "/var/lib/dpkg/info/x:a:b.list": "/usr/bin/x\n",
     "/var/lib/dpkg/info/x.list.list": "/usr/bin/xx\n",
     "/var/lib/dpkg/info/y.md5sums": "/usr/bin/y\n",
     "/var/lib/dpkg/info/z.LIST": "/usr/bin/z\n"
    },
    "exec": {
     "apt-mark showmanual": "x\ny\nz\nx.list\n\n",
     "dpkg-query -Wf ${Package} ${Priority}\n": "x optional\ny optional\nz optional\nx.list optional\n"
    }
   },
   "args": [],
   "out": [
    {
     "name": "x"
    },
    {
     "name": "x.list"
    }
   ],
   "calls": [
    "run apt-mark showmanual",
    "run dpkg-query -Wf ${Package} ${Priority}\n",
    "lines /var/lib/dpkg/info/x:a:b.list",
    "lines /var/lib/dpkg/info/x.list.list"
   ]
  },
  {
   "name": "a later entry of the directory listing replaces the earlier (t.list sorts before t:amd64.list)",
   "laptop": {
    "platform": "linux",
    "which": [
     "apt-mark",
     "dpkg-query"
    ],
    "files": {
     "/var/lib/dpkg/info/t:amd64.list": "/usr/bin/t\n",
     "/var/lib/dpkg/info/t.list": "/usr/share/doc/t\n"
    },
    "exec": {
     "apt-mark showmanual": "t\n",
     "dpkg-query -Wf ${Package} ${Priority}\n": "t optional\n"
    }
   },
   "args": [],
   "out": [
    {
     "name": "t"
    }
   ],
   "calls": [
    "run apt-mark showmanual",
    "run dpkg-query -Wf ${Package} ${Priority}\n",
    "lines /var/lib/dpkg/info/t:amd64.list"
   ]
  },
  {
   "name": "NOT_A_CHOICE is exact and case-sensitive, applied after the trim, survivors in manual order",
   "laptop": {
    "platform": "linux",
    "which": [
     "apt-mark",
     "dpkg-query"
    ],
    "files": {
     "/var/lib/dpkg/info/tmux.list": "/usr/bin/tmux\n",
     "/var/lib/dpkg/info/unminimize.list": "/usr/bin/unminimize\n",
     "/var/lib/dpkg/info/apt-transport-https.list": "/usr/bin/q\n",
     "/var/lib/dpkg/info/Sudo.list": "/usr/bin/q\n"
    },
    "exec": {
     "apt-mark showmanual": "unminimize\r\ntmux\r\nSudo\napt-transport-https\n",
     "dpkg-query -Wf ${Package} ${Priority}\n": "tmux optional\nSudo optional\n"
    }
   },
   "args": [],
   "out": [
    {
     "name": "tmux"
    },
    {
     "name": "Sudo"
    }
   ],
   "calls": [
    "run apt-mark showmanual",
    "run dpkg-query -Wf ${Package} ${Priority}\n",
    "lines /var/lib/dpkg/info/tmux.list",
    "lines /var/lib/dpkg/info/Sudo.list"
   ]
  },
  {
   "name": "a repeated priority line: the last wins (required then optional keeps it)",
   "laptop": {
    "platform": "linux",
    "which": [
     "apt-mark",
     "dpkg-query"
    ],
    "files": {
     "/var/lib/dpkg/info/t.list": "/usr/bin/t\n"
    },
    "exec": {
     "apt-mark showmanual": "t\n",
     "dpkg-query -Wf ${Package} ${Priority}\n": "t required\nt optional\n"
    }
   },
   "args": [],
   "out": [
    {
     "name": "t"

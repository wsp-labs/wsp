 "parse_npm_globals": [
  {
   "name": "version shapes and the names npm and corepack",
   "args": [
    "{\"dependencies\":{\"a\":{\"version\":\"\"},\"b\":{\"version\":1},\"c\":\"x\",\"d\":null,\"e\":[],\"f\":{\"version\":\"1\",\"extra\":1},\"npm\":{},\"corepack\":{},\"npm2\":{}}}"
   ],
   "out": [
    {
     "name": "a",
     "version": ""
    },
    {
     "name": "b"
    },
    {
     "name": "c"
    },
    {
     "name": "d"
    },
    {
     "name": "e"
    },
    {
     "name": "f",
     "version": "1"
    },
    {
     "name": "npm2"
    }
   ]
  },
  {
   "name": "duplicate JSON key: last value, first place",
   "args": [
    "{\"dependencies\":{\"a\":{\"version\":\"1\"},\"b\":{\"version\":\"2\"},\"a\":{\"version\":\"3\"}}}"
   ],
   "out": [
    {
     "name": "a",
     "version": "3"
    },
    {
     "name": "b",
     "version": "2"
    }
   ]
  },
  {
   "name": "wrong shape \"{}\"",
   "args": [
    "{}"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"\"",
   "args": [
    ""
   ],
   "out": []
  },
  {
   "name": "wrong shape \"{\\\"dependencies\\\":null}\"",
   "args": [
    "{\"dependencies\":null}"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"{\\\"dependencies\\\":\\\"x\\\"}\"",
   "args": [
    "{\"dependencies\":\"x\"}"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"\\\"x\\\"\"",
   "args": [
    "\"x\""
   ],
   "out": []
  },
  {
   "name": "wrong shape \"5\"",
   "args": [
    "5"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"[]\"",
   "args": [
    "[]"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"null\"",
   "args": [
    "null"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"{\\\"dependencies\\\":[]}\"",
   "args": [
    "{\"dependencies\":[]}"
   ],
   "out": []
  },
  {
   "name": "wrong shape \"not json\"",
   "args": [
    "not json"
   ],
   "out": []
  },
  {
   "name": "integer-like key first",
   "args": [
    "{\"dependencies\":{\"b\":{\"version\":\"1\"},\"2\":{\"version\":\"2\"},\"a\":{}}}"
   ],
   "out": [
    {
     "name": "2",
     "version": "2"
    },
    {
     "name": "b",
     "version": "1"
    },
    {
     "name": "a"
    }
   ]
  }
 ],
 "parse_pnpm_globals": [
  {
   "name": "dependencies only, junk elements skipped, empty strings kept, no dedupe",
   "args": [
    "[{\"devDependencies\":{\"d\":{\"version\":\"1\"}}},{\"dependencies\":{\"a\":{\"version\":\"\",\"path\":\"\"}}},null,\"x\",[],{\"dependencies\":{\"b\":{\"path\":5,\"version\":\"2\"}}},{\"dependencies\":{\"a\":{\"version\":\"9\",\"path\":\"/p\"}}},{\"dependencies\":null}]"
   ],
   "out": [
    {
     "name": "a",
     "version": "",
     "path": ""
    },
    {
     "name": "b",
     "version": "2"
    },
    {
     "name": "a",
     "version": "9",
     "path": "/p"
    }

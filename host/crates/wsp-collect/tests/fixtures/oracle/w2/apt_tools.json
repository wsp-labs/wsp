 "apt_sizes": [
  {
   "name": "Number() forms",
   "laptop": {
    "exec": {
     "dpkg-query -Wf ${Package} ${Installed-Size}\n": "p0 +5\np1 .5\np2 5.\np3 0b11\np4 0B11\np5 0o17\np6 0XFF\np7 1e400\np8 1_0\np9 -0\np10 1e-1\np11 0x\np12 1,5\np13 00012\np14 1e3\np15 NaN\np16 -Infinity\np17 0.0001\n"
    }
   },
   "args": [
    [
     "p0",
     "p1",
     "p2",
     "p3",
     "p4",
     "p5",
     "p6",
     "p7",
     "p8",
     "p9",
     "p10",
     "p11",
     "p12",
     "p13",
     "p14",
     "p15",
     "p16",
     "p17"
    ]
   ],
   "out": [
    [
     "p0",
     5120
    ],
    [
     "p1",
     512
    ],
    [
     "p2",
     5120
    ],
    [
     "p3",
     3072
    ],
    [
     "p4",
     3072
    ],
    [
     "p5",
     15360
    ],
    [
     "p6",
     261120
    ],
    [
     "p10",
     102.4
    ],
    [
     "p13",
     12288
    ],
    [
     "p14",
     1024000
    ],
    [
     "p17",
     0.1024
    ]
   ],
   "calls": [
    "run dpkg-query -Wf ${Package} ${Installed-Size}\n"
   ]
  },
  {
   "name": "names order, a missing name skipped, a repeated name once at its first place",
   "laptop": {
    "exec": {
     "dpkg-query -Wf ${Package} ${Installed-Size}\n": "a 1\nb 2\nc 3\n"

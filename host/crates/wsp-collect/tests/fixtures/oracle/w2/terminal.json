 "wezterm_font": [
  {
   "name": "weight before family",
   "args": [
    "config.font = wezterm.font({ weight = \"Bold\", family = \"Fira Code\" })\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "apostrophe inside double quotes",
   "args": [
    "config.font = wezterm.font(\"Hack's\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "generic first, the later real one is never tried",
   "args": [
    "config.font = wezterm.font(\"monospace\")\nconfig.font = wezterm.font(\"Fira Code\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "real first",
   "args": [
    "config.font = wezterm.font(\"Fira Code\")\nconfig.font = wezterm.font(\"Hack\")\n"
   ],
   "out": "Fira Code"
  },
  {
   "name": "long bracket comment is not stripped",
   "args": [
    "--[=[\nconfig.font = wezterm.font(\"Old\")\n]=]\nconfig.font = wezterm.font(\"New\")\n"
   ],
   "out": "Old"
  },
  {
   "name": "dashes inside a name",
   "args": [
    "config.font = wezterm.font(\"Fira--Code\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "block comment never closed",
   "args": [
    "--[[\nconfig.font = wezterm.font(\"Old\")\n"
   ],
   "out": "Old"
  },
  {
   "name": "block comments closed on one line",
   "args": [
    "--[[ a ]] config.font = wezterm.font(\"X\") --[[ b ]]\n"
   ],
   "out": "X"
  },
  {
   "name": "mixed quotes",
   "args": [
    "config.font = wezterm.font('Fira Code\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "font_size string",
   "args": [
    "config.font_size = \"14\"\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "bare font string",
   "args": [
    "config.font = \"Fira\"\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "fontconfig call",
   "args": [
    "fontconfig(\"X\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "font = { family }",
   "args": [
    "font = { family = \"Hack\" }\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "font_with_fallback nested family",
   "args": [
    "config.font = wezterm.font_with_fallback({ { family = \"A B\" } })\n"
   ],
   "out": "A B"
  },
  {
   "name": "font_with_fallback family not the first key",
   "args": [
    "config.font = wezterm.font_with_fallback({ { weight = \"Bold\", family = \"A\" } })\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "CRLF and a line comment",
   "args": [
    "config.font = wezterm.font(\"Fira Code\")\r\n-- c\r\n"
   ],
   "out": "Fira Code"
  },
  {
   "name": "empty text",
   "args": [
    ""
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "name padded with spaces",
   "args": [
    "config.font = wezterm.font(\" Fira \")\n"
   ],
   "out": "Fira"
  },
  {
   "name": "name of spaces only",
   "args": [
    "config.font = wezterm.font(\"  \")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "Monospace",
   "args": [
    "config.font = wezterm.font(\"Monospace\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "escaped quotes in the Lua",
   "args": [
    "config.font = wezterm.font(\"Fira \\\"x\\\" Code\")\n"
   ],
   "out": "Fira \\"
  },
  {
   "name": "myfont",
   "args": [
    "myfont(\"Hack\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "subfont",
   "args": [
    "config.subfont(\"Hack\")\n"
   ],
   "out": "JetBrains Mono"
  },
  {
   "name": "call split over lines",
   "args": [
    "config.font = wezterm.font(\n  \"Hack\"\n)\n"
   ],
   "out": "Hack"
  }
 ],
 "alacritty_font": [
  {
   "name": "family under the next table",
   "args": [
    "[font.normal]\nstyle = \"Regular\"\n[font.bold]\nfamily = \"Bold\"\n"
   ],
   "out": null
  },
  {
   "name": "array before the family",
   "args": [
    "[font.normal]\nstyle = [\"a\"]\nfamily = \"Hack\"\n"
   ],
   "out": null
  },
  {
   "name": "single quotes",
   "args": [
    "[font.normal]\nfamily = 'Fira Code'\n"
   ],
   "out": null
  },
  {
   "name": "inline normal with no header",
   "args": [
    "normal = { family = \"Hack\" }\n"
   ],
   "out": "Hack"
  },
  {
   "name": "inline normal under another table",
   "args": [
    "[colors]\nnormal = { family = \"X\" }\n"
   ],
   "out": "X"
  },
  {
   "name": "generic family in toml hides a real yaml one",
   "args": [
    "[font.normal]\nfamily = \"mono\"\nfont:\n  normal:\n    family: Real\n"
   ],
   "out": null
  },
  {
   "name": "generic family in toml",
   "args": [
    "[font.normal]\nfamily = \"mono\"\n"
   ],
   "out": null
  },
  {
   "name": "yaml style before family",
   "args": [
    "font:\n  normal:\n    style: Regular\n    family: Hack\n"
   ],
   "out": "Hack"
  },
  {
   "name": "yaml: the bold family leaks",
   "args": [
    "font:\n  normal:\n    style: R\n  bold:\n    family: Bold\n"
   ],
   "out": "Bold"
  },
  {
   "name": "yaml: normal family first",
   "args": [
    "font:\n  normal:\n    family: N\n  bold:\n    family: B\n"
   ],
   "out": "N"
  },
  {
   "name": "yaml comment tail",
   "args": [
    "font:\n  normal:\n    family: Hack # c\n"
   ],
   "out": "Hack # c"
  },
  {
   "name": "yaml single quotes",
   "args": [
    "font:\n  normal:\n    family: 'Hack Nerd'\n"
   ],
   "out": "Hack Nerd"
  },
  {
   "name": "yaml no final newline",
   "args": [
    "font:\n  normal:\n    family: Hack"
   ],
   "out": "Hack"
  },
  {
   "name": "yaml normal with trailing spaces",
   "args": [
    "font:\n  normal:   \n    family: Hack\n"
   ],
   "out": "Hack"
  },
  {
   "name": "yaml empty family takes the next line",
   "args": [
    "font:\n  normal:\n    family:\n    style: x\n"
   ],
   "out": "style: x"
  },
  {
   "name": "first toml family wins",
   "args": [
    "[font.normal]\nfamily = \"A\"\n[font.bold]\nfamily = \"B\"\n"
   ],
   "out": "A"
  },
  {
   "name": "toml spaces",
   "args": [
    "[font.normal]\n  family   =   \"A B\"  \n"
   ],
   "out": "A B"
  },
  {
   "name": "toml comment line",
   "args": [
    "[font.normal]\n# family = \"Old\"\nfamily = \"New\"\n"
   ],
   "out": "New"
  },
  {
   "name": "commented header still matches",
   "args": [
    "# [font.normal]\nfamily = \"X\"\n"
   ],
   "out": "X"
  },
  {
   "name": "CRLF toml",
   "args": [
    "[font.normal]\r\nfamily = \"Hack\"\r\n"
   ],
   "out": "Hack"
  },
  {
   "name": "CRLF yaml",
   "args": [
    "font:\r\n  normal:\r\n    family: Hack\r\n"
   ],
   "out": "Hack"
  },
  {
   "name": "empty text",
   "args": [
    ""
   ],
   "out": null
  },
  {
   "name": "normal.family spaced",
   "args": [
    "[font]\nnormal.family   =   \"Hack\"\n"
   ],
   "out": "Hack"
  },
  {
   "name": "normal.family under another table",
   "args": [
    "[other]\nnormal.family = \"X\"\n"
   ],
   "out": "X"
  },
  {
   "name": "header with spaces",
   "args": [
    "[ font.normal ]\nfamily = \"X\"\n"
   ],
   "out": null
  },
  {
   "name": "existing: [font] size only",
   "args": [
    "[font]\nsize = 13\n"
   ],
   "out": null
  }
 ],

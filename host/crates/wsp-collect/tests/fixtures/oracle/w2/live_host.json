 "node_fs_read_text": [
  {
   "name": "a BOM is kept",
   "tree": {
    "f": {
     "hex": "ef bb bf 61"
    }
   },
   "op": "read_text",
   "path": "f",
   "out": "﻿a"
  },
  {
   "name": "invalid byte runs become one replacement per maximal subpart",
   "tree": {
    "f": {
     "hex": "61 e2 82 62 f0 9f 98 63 ed a0 80 64 c0 af 65 ff"
    }
   },
   "op": "read_text",
   "path": "f",
   "out": "a�b�c���d��e�"
  },
  {
   "name": "a folder has no text",
   "tree": {
    "d": {
     "dir": true
    }
   },
   "op": "read_text",
   "path": "d",
   "out": null
  },
  {
   "name": "a missing file",
   "tree": {},
   "op": "read_text",
   "path": "nope",
   "out": null
  },
  {
   "name": "an empty file is empty text",
   "tree": {
    "f": ""
   },
   "op": "read_text",
   "path": "f",
   "out": ""
  },
  {
   "name": "a NUL is kept",
   "tree": {
    "f": {
     "hex": "61 00 62"
    }
   },
   "op": "read_text",
   "path": "f",
   "out": "a\u0000b"
  }
 ],
 "node_fs_lines": [
  {
   "name": "an empty file has no lines",
   "tree": {
    "f": ""
   },
   "op": "lines",
   "path": "f",
   "out": []
  },
  {
   "name": "a lone LF is one empty line",
   "tree": {
    "f": "\n"
   },
   "op": "lines",
   "path": "f",
   "out": [
    ""
   ]
  },
  {
   "name": "a lone CR is one empty line",
   "tree": {
    "f": "\r"
   },
   "op": "lines",
   "path": "f",
   "out": [
    ""
   ]
  },
  {
   "name": "two LF are two empty lines",
   "tree": {
    "f": "\n\n"
   },
   "op": "lines",
   "path": "f",
   "out": [
    "",
    ""
   ]
  },
  {
   "name": "a trailing LF gives no last empty line",
   "tree": {
    "f": "a\nb\n"
   },
   "op": "lines",
   "path": "f",
   "out": [
    "a",
    "b"
   ]
  },
  {
   "name": "a BOM is kept",
   "tree": {
    "f": {
     "hex": "ef bb bf 61 0a 62"
    }
   },
   "op": "lines",
   "path": "f",
   "out": [
    "﻿a",
    "b"
   ]
  },
  {
   "name": "a NUL is kept",
   "tree": {
    "f": {
     "hex": "61 00 62 0a"
    }
   },
   "op": "lines",
   "path": "f",
   "out": [
    "a\u0000b"
   ]
  },
  {
   "name": "an empty needle holds every line",
   "tree": {
    "f": "a\n\nb"
   },
   "op": "lines",
   "path": "f",
   "holding": "",
   "out": [
    "a",
    "",
    "b"
   ]
  },
  {
   "name": "a needle holding a CR matches before the CR is dropped",
   "tree": {
    "f": "ab\r\ncd\n"
   },
   "op": "lines",
   "path": "f",
   "holding": "b\r",
   "out": [
    "ab"
   ]
  },
  {
   "name": "a needle without the CR matches the same line",
   "tree": {
    "f": "ab\r\ncd\n"
   },
   "op": "lines",
   "path": "f",
   "holding": "b",
   "out": [
    "ab"
   ]
  },
  {
   "name": "a needle of LF matches nothing",
   "tree": {
    "f": "ab\ncd\n"
   },
   "op": "lines",
   "path": "f",
   "holding": "\n",
   "out": []
  },
  {
   "name": "the needle is case sensitive",
   "tree": {
    "f": "Ab\nab\n"
   },
   "op": "lines",
   "path": "f",
   "holding": "ab",
   "out": [
    "ab"
   ]
  },
  {
   "name": "the needle is matched as UTF-8 bytes",
   "tree": {
    "f": "café\ncafe\n"
   },
   "op": "lines",
   "path": "f",
   "holding": "é",
   "out": [
    "café"
   ]
  },
  {
   "name": "a last line without LF is matched and loses its CR",
   "tree": {
    "f": "x\ny\r"
   },
   "op": "lines",
   "path": "f",
   "holding": "y",
   "out": [
    "y"
   ]
  },
  {
   "name": "CR at the last byte of a read, LF first of the next",
   "tree": {
    "f": {
     "cat": [
      [
       "x",
       1048575
      ],
      [
       "\r\n",
       1
      ],
      [
       "tail\n",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "lens": true,
   "out_lens": [
    1048575,
    4
   ]
  },
  {
   "name": "a line exactly one read long, then its LF",
   "tree": {
    "f": {
     "cat": [
      [
       "x",
       1048576
      ],
      [
       "\n",
       1
      ],
      [
       "y\n",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "lens": true,
   "out_lens": [
    1048576,
    1
   ]
  },
  {
   "name": "a needle straddling the read boundary",
   "tree": {
    "f": {
     "cat": [
      [
       "a\n",
       1
      ],
      [
       "y",
       1048570
      ],
      [
       "TOOL",
       1
      ],
      [
       "z",
       10
      ],
      [
       "\nq\n",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "holding": "TOOL",
   "lens": true,
   "out_lens": [
    1048584
   ]
  },
  {
   "name": "lines ending exactly at the read end",
   "tree": {
    "f": {
     "cat": [
      [
       "x",
       1048575
      ],
      [
       "\n",
       1
      ],
      [
       "w",
       1048575
      ],
      [
       "\n",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "lens": true,
   "out_lens": [
    1048575,
    1048575
   ]
  },
  {
   "name": "a CR as the last byte of the file at the read end",
   "tree": {
    "f": {
     "cat": [
      [
       "x",
       1048575
      ],
      [
       "\r",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "lens": true,
   "out_lens": [
    1048575
   ]
  },
  {
   "name": "a multi-byte character across the read boundary",
   "tree": {
    "f": {
     "cat": [
      [
       "a",
       1048575
      ],
      [
       "é",
       1
      ],
      [
       "\nz",
       1
      ]
     ]
    }
   },
   "op": "lines",
   "path": "f",
   "lens": true,
   "out_lens": [
    1048576,
    1
   ]
  },
  {
   "name": "a folder gives no lines",
   "tree": {
    "d": {
     "dir": true
    }
   },
   "op": "lines",
   "path": "d",
   "out": []
  },
  {
   "name": "a missing file gives no lines",
   "tree": {},
   "op": "lines",
   "path": "nope",
   "out": []
  }
 ],

{
 "node_fs_stat": [
  {
   "name": "a file",
   "tree": {
    "f": "hello"
   },
   "op": "stat",
   "path": "f",
   "out": {
    "kind": "file",
    "bytes": 5
   }
  },
  {
   "name": "a missing path",
   "tree": {},
   "op": "stat",
   "path": "nope",
   "out": null
  },
  {
   "name": "git and node_modules folders and links are not sized",
   "tree": {
    "tree/a.txt": "abc",
    "tree/sub/b.txt": "defg",
    "tree/.git/c": {
     "bytes": 100
    },
    "tree/node_modules/d": {
     "bytes": 100
    },
    "tree/deep/x/.git/y": {
     "bytes": 50
    },
    "tree/link": {
     "link": "<dir>/tree/a.txt"
    }
   },
   "op": "stat",
   "path": "tree",
   "out": {
    "kind": "dir",
    "bytes": 7
   }
  },
  {
   "name": "a file named .git or node_modules is sized; an empty .git2 folder is not a problem",
   "tree": {
    "t/.git": "0123456789",
    "t/sub/node_modules": "abc",
    "t/a": "12",
    "t/.git2/": {
     "dir": true
    }
   },
   "op": "stat",
   "path": "t",
   "out": {
    "kind": "dir",
    "bytes": 15
   }
  },
  {
   "name": "the root may be named node_modules",
   "tree": {
    "node_modules/x/f": {
     "bytes": 5
    }
   },
   "op": "stat",
   "path": "node_modules",
   "out": {
    "kind": "dir",
    "bytes": 5
   }
  },
  {
   "name": "an empty folder",
   "tree": {
    "empty": {
     "dir": true
    }
   },
   "op": "stat",
   "path": "empty",
   "out": {
    "kind": "dir",
    "bytes": 0
   }
  },
  {
   "name": "a hard link is counted twice",
   "tree": {
    "real/f": {
     "bytes": 7
    },
    "real/hard": {
     "hardlink": "real/f"
    }
   },
   "op": "stat",
   "path": "real",
   "out": {
    "kind": "dir",
    "bytes": 14
   }
  },
  {
   "name": "a fifo has no stat",
   "tree": {
    "ff": {
     "fifo": true
    }
   },
   "op": "stat",
   "path": "ff",
   "out": null
  },
  {
   "name": "a fifo in a folder is not counted",
   "tree": {
    "d/ff": {
     "fifo": true
    },
    "d/f": {
     "bytes": 3
    }
   },
   "op": "stat",
   "path": "d",
   "out": {
    "kind": "dir",
    "bytes": 3
   }
  },
  {
   "name": "a link to a folder is followed",
   "tree": {
    "real/f": {
     "bytes": 7
    },
    "linkdir": {
     "link": "<dir>/real"
    },
    "linkfile": {
     "link": "<dir>/real/f"
    },
    "broken": {
     "link": "<dir>/nope"
    }
   },
   "op": "stat",
   "path": "linkdir",
   "out": {
    "kind": "dir",
    "bytes": 7
   }
  },
  {
   "name": "a link to a file is followed",
   "tree": {
    "real/f": {
     "bytes": 7
    },
    "linkdir": {
     "link": "<dir>/real"
    },
    "linkfile": {
     "link": "<dir>/real/f"
    },
    "broken": {
     "link": "<dir>/nope"
    }
   },
   "op": "stat",
   "path": "linkfile",
   "out": {
    "kind": "file",
    "bytes": 7
   }
  },
  {
   "name": "a broken link has no stat",
   "tree": {
    "real/f": {
     "bytes": 7
    },
    "linkdir": {
     "link": "<dir>/real"
    },
    "linkfile": {
     "link": "<dir>/real/f"
    },
    "broken": {
     "link": "<dir>/nope"
    }
   },
   "op": "stat",
   "path": "broken",
   "out": null
  },
  {
   "name": "a path under a file has no stat",
   "tree": {
    "f": "x"
   },
   "op": "stat",
   "path": "f/g",
   "out": null
  }
 ],
 "node_fs_list": [
  {

     "bytes": 7
    },
    "linkdir": {
     "link": "<dir>/real"
    },
    "linkfile": {
     "link": "<dir>/real/f"
    },
    "broken": {
     "link": "<dir>/nope"
    }
   },
   "op": "list",
   "path": "real/f",
   "out": []
  },
  {
   "name": "a missing folder",
   "tree": {},
   "op": "list",
   "path": "nope",
   "out": []
  },
  {
   "name": "an empty folder",
   "tree": {
    "e": {
     "dir": true
    }
   },
   "op": "list",
   "path": "e",
   "out": []
  },
  {
   "name": "git and node_modules are listed by name",
   "tree": {
    "tree/a.txt": "abc",
    "tree/sub/b.txt": "defg",
    "tree/.git/c": {
     "bytes": 100
    },
    "tree/node_modules/d": {
     "bytes": 100
    },
    "tree/deep/x/.git/y": {
     "bytes": 50
    },
    "tree/link": {
     "link": "<dir>/tree/a.txt"
    }
   },
   "op": "list",
   "path": "tree",
   "out": [
    ".git",
    "a.txt",
    "deep",
    "link",
    "node_modules",
    "sub"
   ]
  }
 ],
 "node_fs_walk": [
  {
   "name": "whole paths sort by UTF-16 units: a-b/x before a/B, an astral name before U+FF21",
   "tree": {
    "w/a/x": "",
    "w/a-b/x": "",
    "w/a.b/x": "",
    "w/a0": "",
    "w/B": "",
    "w/b": "",
    "w/é": "",
    "w/Ａ": "",
    "w/😀": "",
    "w/a/B": "",
    "w/a/a": ""
   },
   "op": "walk",
   "path": "w",
   "out": [
    "<dir>/w/B",
    "<dir>/w/a-b/x",
    "<dir>/w/a.b/x",
    "<dir>/w/a/B",
    "<dir>/w/a/a",
    "<dir>/w/a/x",
    "<dir>/w/a0",
    "<dir>/w/b",
    "<dir>/w/é",
    "<dir>/w/😀",
    "<dir>/w/Ａ"
   ]
  },
  {

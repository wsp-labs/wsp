    "<dir>/w/B",
    "<dir>/w/a-b/x",
    "<dir>/w/a.b/x",
    "<dir>/w/a/B",
    "<dir>/w/a/a",
    "<dir>/w/a/x",
    "<dir>/w/a0",
    "<dir>/w/b",
    "<dir>/w/é",
    "<dir>/w/😀",
    "<dir>/w/Ａ"
   ]
  },
  {
   "name": "dot-dot segments are normalised",
   "tree": {
    "w/a/x": "",
    "w/a-b/x": "",
    "w/a.b/x": "",
    "w/a0": "",
    "w/B": "",
    "w/b": "",
    "w/é": "",
    "w/Ａ": "",
    "w/😀": "",
    "w/a/B": "",
    "w/a/a": ""
   },
   "op": "walk",
   "path": "w/a/../a-b",

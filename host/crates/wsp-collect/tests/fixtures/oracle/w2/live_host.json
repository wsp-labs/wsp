     "bytes": 7
    },
    "linkdir": {
     "link": "<dir>/real"
    },
    "linkfile": {
     "link": "<dir>/real/f"
    },
    "broken": {
     "link": "<dir>/nope"
    }
   },
   "op": "list",
   "path": "linkdir",
   "out": [
    "f"
   ]
  },
  {
   "name": "a file has no names",

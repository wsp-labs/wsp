  "ecosystems": [
    {
      "id": "npm",
      "lockfiles": [
        "package-lock.json",
        "npm-shrinkwrap.json"
      ],
      "carry": [
        "node_modules"
      ],
      "never": [
        ".next",
        ".turbo",
        ".cache"
      ],
      "rebuild": "npm install --no-save --prefer-offline --no-audit --no-fund"
    },
    {
      "id": "pnpm",
      "lockfiles": [
        "pnpm-lock.yaml"
      ],
      "carry": [
        "node_modules"
      ],
      "never": [
        ".next",
        ".turbo",
        ".cache"
      ],
      "installed": "node_modules/.pnpm/lock.yaml",
      "rebuild": "pnpm install --frozen-lockfile --prefer-offline"
    },
    {
      "id": "yarn",
      "lockfiles": [
        "yarn.lock"
      ],
      "carry": [
        "node_modules",
        ".yarn/cache",
        ".yarn/unplugged"
      ],
      "never": [
        ".next",
        ".turbo",
        ".cache"
      ],
      "rebuild": "yarn install --frozen-lockfile"
    },
    {
      "id": "bun",
      "lockfiles": [
        "bun.lock",
        "bun.lockb"
      ],
      "carry": [
        "node_modules"
      ],
      "never": [
        ".next",
        ".turbo",
        ".cache"
      ],
      "rebuild": "bun install --frozen-lockfile"
    },
    {

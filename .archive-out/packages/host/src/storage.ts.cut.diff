-  try {
-    at = await o.rt.golden.retentionPlaces();
-  } catch (e) {
-    say(o, "warn", `Snapshot storage was not read (${e instanceof Error ? e.message : String(e)}); every image version is kept.`);
-    return;
-  }
-  for (const place of at) await offerAt(o, place);
-}

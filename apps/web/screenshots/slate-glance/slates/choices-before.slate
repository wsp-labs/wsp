<slate title="Native desktop app">
  <value name="lookDiagrams" start="" />
  <value name="lookSwitcher" start="" />
  <value name="lookActivity" start="" />
  <value name="pictures" start="" />
  <value name="runBand" start="" />
  <value name="wayland" start="" />
  <derived name="answers"
      value={{ diagrams: $lookDiagrams, switcher: $lookSwitcher, activity: $lookActivity, pictures: $pictures, runBand: $runBand, wayland: $wayland }} />
  <run name="progress"
      cmd="WSP_HOME=/Users/ada/wsp-work/ui-home /Users/ada/wsp-work/ui-home/thread-bin/wsp threads wsp --json 2>/dev/null"
      every={30} then='python3 "$SLATE_DIR/progress.py"' />
  <run name="gate" cmd='python3 "$SLATE_DIR/gate-status.py"' every={10} always />
  <run name="mac" cmd='python3 "$SLATE_DIR/mac-status.py"' every={15} always />
  <column id="page" gap="loose">
    <section id="choices" title="Your choices">
      <choices id="choice-diagrams"
          label="Slate diagrams: today's app draws them. The new one would show their source text first, with drawn diagrams later."
          value={$lookDiagrams}>
        <option value="yes" label="Yes, source text first"
            note="Every other slate piece ships first; diagrams draw in a later round." />
        <option value="no" label="No, draw them before slates ship"
            note="Adds a diagram renderer to the slates work." />
      </choices>
      <choices id="choice-switcher"
          label="Thread switcher: today's cards show a small picture of each thread. The new app can't capture those yet."
          value={$lookSwitcher}>
        <option value="yes" label="Yes, cards without pictures for now" />
        <option value="no" label="No, build the picture capture first" />
      </choices>
      <choices id="choice-activity"
          label="Activity page: when a computer can't be reached, today's loading placeholder shimmers. Holding it still saves CPU."
          value={$lookActivity}>
        <option value="yes" label="Yes, hold it still" />
        <option value="no" label="No, shimmer like today" />
      </choices>
      <choices id="choice-pictures"
          label="Pictures of today's app at Retina scale, taken on your Mac: 88 MB for both batches (68 MB first, 20 MB second)."
          value={$pictures}>
        <option value="hashes" label="Fingerprints in git, pictures kept on your Mac"
            note="My pick. Light repo; checks compare against your Mac's pictures by fingerprint." />
        <option value="lfs" label="Git LFS" note="Needs LFS set up on the repo." />
        <option value="git" label="All in git" note="Simplest; the repo grows by about 88 MB for good." />
        <option value="release" label="Attached to a GitHub release" note="Publishes them on GitHub." />
      </choices>
      <choices id="choice-runband"
          label="Dark theme, a command's output under a code block: today's app draws it see-through (two CSS rules override its terminal background by accident). The new app draws the terminal background it was meant to have."
          value={$runBand}>
        <option value="fixed" label="Keep the terminal background"
            note="Listed as a deliberate difference; the two rules in today's app get fixed too." />
        <option value="copy" label="Copy today's see-through band" note="Matches today's app pixel for pixel." />
      </choices>
      <choices id="choice-wayland"
          label="On Linux under Wayland, no web view can sit inside the new app's window yet. What should the browser pane do there?"
          value={$wayland}>
        <option value="system" label="Open the page in the system browser"
            note="My pick. The app stays a native Wayland app; the pane says why in one line." />
        <option value="xwayland" label="Run the whole app on XWayland"
            note="The page shows inside the pane; the app loses native Wayland (sharper text at fractional scales, smoother resizes)." />
      </choices>
      <row id="choices-row">
        <button id="send-choices" variant="primary"
            held={$lookDiagrams == "" || $lookSwitcher == "" || $lookActivity == "" || $pictures == "" || $runBand == "" || $wayland == "" ? "Pick all six first" : ""}
            onPress={send("Here are my answers on the look choices and where the pictures live.", $answers)}>Send my answers</button>
      </row>
    </section>
  </column>
  <file name="progress.py">{`
    import json, sys

    STATES = {"running": ("Working", "info"), "completed": ("Finished", "good"), "failed": ("Stopped", "bad")}
    p = json.load(open("/Users/ada/wsp-work/coord/briefs/gpui/progress.json"))
    try:
        threads = {t["id"][:8]: t.get("status", "") for t in json.load(sys.stdin).get("threads", [])}
    except Exception:
        threads = {}
    helpers = []
    for h in p.get("helpers", []):
        state, tone = STATES.get(threads.get(h["id"], ""), ("Starting", "muted"))
        helpers.append({"name": h["name"], "state": state, "tone": tone})
    steps = p.get("steps", [])
    screens = p.get("screens", [])
    print(json.dumps({
        "goal": p.get("goal", ""),
        "timeline": p.get("timeline", ""),
        "leak": p.get("leak", ""),
        "asks": p.get("asks", []),
        "steps": steps,
        "done": sum(1 for s in steps if s.get("state") == "done"),
        "total": len(steps),
        "screens": screens,
        "inapp": sum(1 for s in screens if s.get("state") == "In the app"),
        "screenTotal": len(screens),
        "helpers": helpers,
        "running": sum(1 for h in helpers if h["state"] == "Working"),
    }))
  `}</file>
</slate>

<slate title="Why dev4 went Unreachable">
  <value name="resend" start="" />
  <column>
    <text>Three test runs filled dev4's memory, its daemon starved and stopped answering, and the host cut every turn after 60 s of silence.</text>
    <table id="parts" items={[
      { part: "App", where: "This Mac", did: "Showed the box as Unreachable" },
      { part: "Host", where: "This Mac", did: "Redialled the daemon for 60 s, then cut each turn" },
      { part: "Daemon", where: "dev4", did: "Starved of memory and stopped answering" },
      { part: "Three turns", where: "dev4", did: "Two remerges and a review, all running vitest" }
    ]} key={item.part}>
      <col title="Part" value={item.part} width="fit" />
      <col title="On" value={item.where} width="fit" />
      <col title="What it did" value={item.did} width="fill" />
    </table>
    <stats id="hit">
      <stat label="Test runs at once" value={3} format="integer" window="on a 4 GB box" />
      <stat label="Turns failed" value={3} max={3} format="fraction" window="2026-09-06" tone="bad" />
      <stat label="Link silent for" value={60} unit="s" window="then the host cut each turn" />
    </stats>
    <decision id="resend" label="Resend the three cut turns?" value={$resend} pick="queue" onChange={send("Resend", $resend)}>
      <option value="queue" label="Resend all three" note="Two run, one per 2048 MB; the third waits" />
      <option value="one" label="Resend the review only" />
      <option value="none" label="Leave them" />
    </decision>
  </column>
</slate>

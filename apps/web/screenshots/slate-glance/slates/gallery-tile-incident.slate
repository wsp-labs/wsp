<slate title="Checkout returning 502s">
  <value name="errorRate" start={4.8} />
  <value name="ordersPerMin" start={212} />
  <value name="poolUsed" start={8} />
  <value name="poolSize" start={8} />
  <value name="rollback" start="" />
  <column>
    <row>
      <number label="5xx rate" value={$errorRate} unit="%" tone="bad" />
      <status tone="bad">Rising</status>
      <number label="Orders/min" value={$ordersPerMin} note="normally 640" />
      <meter label="DB pool" value={$poolUsed} max={$poolSize} format="fraction" tone="bad" note="full since 14:02" />
    </row>
    <decision id="rollback" label="Roll back release 2026.10.25-3?" value={$rollback} pick="rollback" onChange={send("Roll back checkout", $rollback)}>
      <option value="rollback" label="Roll back now" note="It cut the pool from 20 to 8 at 14:00" />
      <option value="patch" label="Raise the pool size" note="A config push, about 6 minutes" />
    </decision>
  </column>
</slate>

<slate title="Why the review waits on dogfood-r1">
  <value name="next" start="" />
  <column>
    <frame id="slots" src="show-box-slots.html" caption="Two slots on 4 GB, the review first in line" />
    <stats id="now">
      <stat label="Running" value={2} max={2} format="fraction" window="threads at once" />
      <stat label="Waiting" value={1} format="integer" window="the review, first in line" />
      <stat label="Memory" value={3915} unit="MB" window="free -m on the box" />
    </stats>
    <decision id="next" label="Start the review now?" value={$next} pick="wait" onChange={send("Review start", $next)}>
      <option value="wait" label="Let it wait" note="It starts on its own when either running thread ends" />
      <option value="mac" label="Move it to this Mac" note="6 of 8 slots free here" />
      <option value="raise" label="Raise the box to 3 at once" note="At three on this box every turn died, 2026-09-12" />
    </decision>
  </column>
</slate>

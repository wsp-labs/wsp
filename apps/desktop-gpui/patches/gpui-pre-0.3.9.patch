+/// A rounded rectangle that clips what is painted inside it, antialiased, on top of the content mask, which
+/// carries its bounds. Nested clips all apply.
+#[derive(Copy, Clone, Debug, Default, PartialEq, Eq)]
+#[repr(C)]
+pub struct RoundedClip<P: Clone + Debug + Default + PartialEq> {
+    /// The bounds
+    pub bounds: Bounds<P>,
+    /// The radius of each corner
+    pub corner_radii: Corners<P>,
+    /// Where an alpha ramp starts and ends, top to bottom: whole above `fade_top`, gone below `fade_bottom`, like
+    /// CSS's `mask-image: linear-gradient(to bottom, black, transparent)` between them. Equal, the clip fades nothing.
+    pub fade_top: P,
+    /// Where the ramp reaches nothing.
+    pub fade_bottom: P,
+}
+
+impl<P: Clone + Debug + Default + PartialEq + PartialOrd> RoundedClip<P> {
+    /// Whether the clip fades what it clips.
+    pub fn fades(&self) -> bool {
+        self.fade_bottom > self.fade_top
+    }
+}
+
+impl RoundedClip<ScaledPixels> {
+    /// Whether the clip cuts any of `bounds` that its own bounds do not: where `bounds` reaches into a rounded
+    /// corner or past the clip's edges.
+    fn cuts(&self, bounds: &Bounds<ScaledPixels>) -> bool {
+        let clip = self.bounds;
+        let radii = self.corner_radii;
+        let corner = |x, y, radius: ScaledPixels| Bounds {
+            origin: point(x, y),
+            size: size(radius, radius),
+        };
+        bounds.intersect(&clip) != *bounds
+            || self.fades() && bounds.bottom() > self.fade_top
+            || [
+                corner(clip.left(), clip.top(), radii.top_left),
+                corner(clip.right() - radii.top_right, clip.top(), radii.top_right),
+                corner(
+                    clip.right() - radii.bottom_right,
+                    clip.bottom() - radii.bottom_right,
+                    radii.bottom_right,
+                ),
+                corner(clip.left(), clip.bottom() - radii.bottom_left, radii.bottom_left),
+            ]
+            .iter()
+            .any(|corner| corner.intersects(bounds))
+    }
+}
+
+impl RoundedClip<Pixels> {
+    /// Scale the clip's pixel units by the given scaling factor.
+    pub fn scale(&self, factor: f32) -> RoundedClip<ScaledPixels> {
+        RoundedClip {
+            bounds: self.bounds.scale(factor),
+            corner_radii: self.corner_radii.scale(factor),
+            fade_top: self.fade_top.scale(factor),
+            fade_bottom: self.fade_bottom.scale(factor),
+        }
+    }

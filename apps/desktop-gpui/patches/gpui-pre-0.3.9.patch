+    /// Reuses a cached view's paint from last frame at `old`, painting again in place each child prepainted again.
+    pub(crate) fn splice_paint(
+        &mut self,
+        children: &mut [CachedChild],
+        old: &Range<PaintIndex>,
+        mut paint_child: impl FnMut(&CachedChild, Range<PaintIndex>, &mut Self),
+    ) {
+        let start = self.paint_index();
+        let mut cursor = old.start.clone();
+        let (mut part_old, mut part_new) = (old.start.clone(), start.clone());
+        for child in children.iter_mut() {
+            let Some(paint) = &child.paint else { continue };
+            let child_old = old.start.offset_by(&paint.start)..old.start.offset_by(&paint.end);
+            if !self.spliced_elements.contains_key(&child.global_id) {

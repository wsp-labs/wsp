+/// The zoom a window opens at.
+struct WindowZoom(f32);
+
+impl Global for WindowZoom {}
+
+impl App {
+    /// Zooms every window, and each opened after, by `zoom`; see [`Window::zoom`].
+    pub fn set_window_zoom(&mut self, zoom: f32) {
+        self.set_global(WindowZoom(zoom));
+        // Deferred, as a window being updated is out of reach until its update returns.
+        self.defer(|cx| {
+            let zoom = cx.window_zoom();
+            for handle in cx.windows() {
+                handle
+                    .update(cx, |_, window, cx| window.set_zoom(zoom, cx))
+                    .log_err();
+            }
+        });
+    }
+
+    /// The zoom [`Self::set_window_zoom`] last set, 1 before it is called.
+    pub fn window_zoom(&self) -> f32 {
+        self.try_global::<WindowZoom>().map_or(1., |zoom| zoom.0)
+    }

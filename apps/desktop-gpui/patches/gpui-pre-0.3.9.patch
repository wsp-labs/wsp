+/// Paints a cached view its parent drew again in place, under what it was painted under last frame, returning the
+/// entities it read.
+fn paint_in_place(
+    child: &CachedChild,
+    old: Range<PaintIndex>,
+    window: &mut Window,
+    cx: &mut App,
+) -> FxHashSet<EntityId> {
+    let element = window.spliced_elements.remove(&child.global_id).flatten();
+    let entity_id = child.view.entity_id();
+    window.with_element_state_in_place::<ViewElementState, _>(&child.global_id, |element_state, window| {
+        let mut element_state =
+            element_state.expect("a cached view prepainted this frame keeps its state");
+        let context = element_state
+            .paint_context
+            .clone()
+            .expect("a cached view its parent placed was painted");
+        window.with_draw_context(&child.global_id, &context, cx, |window, cx| {
+            window.with_rendered_view(entity_id, |window| {
+                paint_cached(&mut element_state, element, old, window, cx);
+            })
+        });
+        (element_state.accessed_entities.clone(), element_state)
+    })
+}

+    /// Get the rounded clip for this element style: like CSS, an element that hides its overflow on both axes
+    /// clips its children to its rounded padding box. Returns `None` when it does not, or has square corners.
+    pub fn overflow_rounded_clip(
+        &self,
+        bounds: Bounds<Pixels>,
+        rem_size: Pixels,
+    ) -> Option<RoundedClip<Pixels>> {
+        if self.overflow.x == Overflow::Visible || self.overflow.y == Overflow::Visible {
+            return None;
+        }
+        let mut corner_radii = self
+            .corner_radii
+            .to_pixels(rem_size)
+            .clamp_radii_for_quad_size(bounds.size);
+        let mut bounds = bounds;
+        if self.is_border_visible() {
+            let border = self.border_widths.to_pixels(rem_size);
+            bounds = Bounds::from_corners(
+                point(bounds.left() + border.left, bounds.top() + border.top),
+                point(bounds.right() - border.right, bounds.bottom() - border.bottom),
+            );
+            let inner = |radius: Pixels, a: Pixels, b: Pixels| (radius - a.max(b)).max(Pixels::ZERO);
+            corner_radii = Corners {
+                top_left: inner(corner_radii.top_left, border.top, border.left),
+                top_right: inner(corner_radii.top_right, border.top, border.right),
+                bottom_right: inner(corner_radii.bottom_right, border.bottom, border.right),
+                bottom_left: inner(corner_radii.bottom_left, border.bottom, border.left),
+            };
+        }
+        // A rounded clip with square corners would replace an outer one that still rounds.
+        if corner_radii == Corners::default() {
+            return None;
+        }
+        Some(RoundedClip {
+            bounds,
+            corner_radii,
+        })
+    }

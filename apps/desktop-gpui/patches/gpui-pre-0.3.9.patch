+/// Paints a cached view: the element its prepaint rendered, or last frame's paint at `old` with the views inside it
+/// drawn again in place painted again.
+fn paint_cached(
+    element_state: &mut ViewElementState,
+    element: Option<AnyElement>,
+    old: Range<PaintIndex>,
+    window: &mut Window,
+    cx: &mut App,
+) -> Range<PaintIndex> {
+    let paint_start = window.paint_index();
+    let moved = if let Some(mut element) = element {
+        let refreshing = mem::replace(&mut window.refreshing, true);
+        window.cached_paints.push(Vec::new());
+        let ((), read, accessed) = cx.detect_accessed_entities(|cx| element.paint(window, cx));
+        element_state.read_entities.extend(read);
+        element_state.accessed_entities.extend(accessed);
+        let painted: FxHashMap<GlobalElementId, Range<PaintIndex>> = window
+            .cached_paints
+            .pop()
+            .unwrap_or_default()
+            .into_iter()
+            .collect();
+        for child in &mut element_state.children {
+            child.paint = painted.get(&child.global_id).map(|range| {
+                range.start.offset_from(&paint_start)..range.end.offset_from(&paint_start)
+            });
+        }
+        window.refreshing = refreshing;
+        false
+    } else if mem::take(&mut element_state.spliced) {
+        let ViewElementState {
+            children,
+            accessed_entities,
+            ..
+        } = element_state;
+        window.splice_paint(children, &old, |child, child_old, window| {
+            accessed_entities.extend(paint_in_place(child, child_old, window, cx));
+        });
+        true
+    } else {
+        let fonts_kept = old.start.same_fonts(&paint_start);
+        window.reuse_paint(old);
+        if !fonts_kept {
+            element_state.children.iter_mut().for_each(|child| child.paint = None);
+        }
+        element_state.between_in_place
+    };
+    let paint_end = window.paint_index();
+    if !paint_start.same_fonts(&paint_end) {
+        element_state.children.iter_mut().for_each(|child| child.paint = None);
+    } else if moved {
+        // Each child's output moved, and a parent drawing it next may reuse it by its own record.
+        let frame_index = window.frame_index;
+        for child in &element_state.children {
+            let Some(paint) = &child.paint else { continue };
+            let prepaint_range = element_state.prepaint_range.start.offset_by(&child.prepaint.start)
+                ..element_state.prepaint_range.start.offset_by(&child.prepaint.end);
+            let paint_range = paint_start.offset_by(&paint.start)..paint_start.offset_by(&paint.end);
+            window.update_element_state::<ViewElementState>(&child.global_id, |state| {
+                state.prepaint_range = prepaint_range;
+                state.paint_range = paint_range;
+                state.paint_pending = false;
+                state.placed = frame_index;
+            });
+        }
+    }
+    element_state.paint_range = paint_start.clone()..paint_end.clone();
+    element_state.paint_pending = false;
+    paint_start..paint_end
+}

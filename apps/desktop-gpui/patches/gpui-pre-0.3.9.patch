+
+    /// Runs `f` inside `scope`; a view drawn in `f` and drawn again in place later, with nothing above it drawn,
+    /// runs inside it again.
+    pub fn with_draw_scope<R>(
+        &mut self,
+        scope: &DrawScope,
+        cx: &mut App,
+        f: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> R {
+        self.draw_scopes.push(scope.clone());
+        let out = self.within_scopes(std::slice::from_ref(scope), cx, f);
+        self.draw_scopes.pop();
+        out
+    }
+
+    fn within_scopes<R>(
+        &mut self,
+        scopes: &[DrawScope],
+        cx: &mut App,
+        f: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> R {
+        let Some((outer, inner)) = scopes.split_first() else {
+            return f(self, cx);
+        };
+        let (mut f, mut out) = (Some(f), None);
+        outer(self, cx, &mut |window, cx| {
+            if let Some(f) = f.take() {
+                out = Some(window.within_scopes(inner, cx, f));
+            }
+        });
+        out.expect("a draw scope runs its body")
+    }
+
+    /// Runs `f` as the element at `global_id` ran under `context`, with nothing above it on the stacks.
+    pub(crate) fn with_draw_context<R>(
+        &mut self,
+        global_id: &GlobalElementId,
+        context: &DrawContext,
+        cx: &mut App,
+        f: impl FnOnce(&mut Self, &mut App) -> R,
+    ) -> R {
+        let mut element_id_stack = ElementIdStack::default();
+        for id in global_id.iter() {
+            element_id_stack.push(id.clone());
+        }
+        let element_id_stack = mem::replace(&mut self.element_id_stack, element_id_stack);
+        let text_style_stack =
+            mem::replace(&mut self.text_style_stack, context.text_style_stack.clone());
+        let rem_size_override_stack = mem::replace(
+            &mut self.rem_size_override_stack,
+            SmallVec::from_slice(&[context.rem_size]),
+        );
+        let content_mask_stack = mem::replace(&mut self.content_mask_stack, vec![context.content_mask]);
+        let rounded_clip_stack =
+            mem::replace(&mut self.rounded_clip_stack, context.rounded_clip_stack.clone());
+        let opacity = mem::replace(&mut self.element_opacity, context.opacity);
+        let image_cache_stack =
+            mem::replace(&mut self.image_cache_stack, context.image_cache_stack.clone());
+        let element_offset_stack = mem::take(&mut self.element_offset_stack);
+        // A scope this one's parent drawn in place already entered stays entered: entering it again would undo it.
+        let entered = self
+            .draw_scopes
+            .iter()
+            .zip(&context.draw_scopes)
+            .take_while(|(active, saved)| Rc::ptr_eq(active, saved))
+            .count();
+        let draw_scopes = mem::replace(&mut self.draw_scopes, context.draw_scopes.clone());
+        let result = self.within_scopes(&context.draw_scopes[entered..], cx, f);
+        self.draw_scopes = draw_scopes;
+        self.element_id_stack = element_id_stack;
+        self.text_style_stack = text_style_stack;
+        self.rem_size_override_stack = rem_size_override_stack;
+        self.content_mask_stack = content_mask_stack;
+        self.rounded_clip_stack = rounded_clip_stack;
+        self.element_opacity = opacity;
+        self.image_cache_stack = image_cache_stack;
+        self.element_offset_stack = element_offset_stack;
+        result
+    }
+
+    /// Which of a cached view's `children` to draw again in place for `route`, or none when one is not among
+    /// them (drawn deferred, or not cached) or its output cannot be placed, and the view must draw whole.
+    pub(crate) fn splice_plan(
+        &self,
+        route: &[EntityId],
+        children: &[CachedChild],
+        old: &Range<PrepaintStateIndex>,
+        state_type: TypeId,
+    ) -> Option<SmallVec<[usize; 2]>> {
+        if !old
+            .start
+            .line_layout_index
+            .same_generation(&self.text_system.layout_index())
+        {
+            return None;
+        }
+        let mut plan = SmallVec::<[usize; 2]>::new();
+        for wanted in route {
+            let ix = children
+                .iter()
+                .position(|child| child.view.entity_id() == *wanted)?;
+            let child = &children[ix];
+            child.paint.as_ref()?;
+            child.view.upgrade()?;
+            plan.push(ix);
+        }
+        plan.sort_unstable();
+        plan.dedup();
+        let mut cursor = PrepaintStateIndex::default();
+        for child in children {
+            if !cursor.at_or_before(&child.prepaint.start)
+                || !child.prepaint.start.at_or_before(&child.prepaint.end)
+                || child.prepaint.start.dispatch_tree_index == 0
+                || !old.start.offset_by(&child.prepaint.end).at_or_before(&old.end)
+            {
+                return None;
+            }
+            cursor = child.prepaint.end.clone();
+        }
+        // Each child's record must still point at its own output last frame: its view's node just before it, and
+        // its state's key just before it or first in it.
+        for &ix in &plan {
+            let child = &children[ix];
+            let start = old.start.offset_by(&child.prepaint.start);
+            if self.rendered_frame.dispatch_tree.view_at(start.dispatch_tree_index - 1) != Some(child.view.entity_id()) {
+                return None;
+            }
+            let keys = &self.rendered_frame.accessed_element_states;
+            let at = start.accessed_element_states_index;
+            let own = |ix: usize| keys.get(ix).is_some_and(|(id, ty)| *ty == state_type && *id == child.global_id);
+            if !(at > 0 && own(at - 1) || own(at)) {
+                return None;
+            }
+        }
+        // A parent that paints its children in another order than it prepainted them cannot be painted in parts.
+        let mut painted = PaintIndex::default();
+        for paint in children.iter().filter_map(|child| child.paint.as_ref()) {
+            if !painted.at_or_before(&paint.start) || !paint.start.at_or_before(&paint.end) {
+                return None;
+            }
+            painted = paint.end.clone();
+        }
+        Some(plan)
+    }
+
+    /// Reuses a cached view's prepaint from last frame at `old`, drawing the planned children again in place with
+    /// `prepaint_child`, given each one's own output last frame.
+    pub(crate) fn splice_prepaint(
+        &mut self,
+        children: &mut [CachedChild],
+        old: &Range<PrepaintStateIndex>,
+        plan: &[usize],
+        mut prepaint_child: impl FnMut(&CachedChild, Range<PrepaintStateIndex>, &mut Self),
+    ) -> Range<PrepaintStateIndex> {
+        let start = self.prepaint_index();
+        let mut reuse = SplicedReuse::default();
+        let mut cursor = old.start.clone();
+        let (mut part_old, mut part_new) = (old.start.clone(), start.clone());
+        for (ix, child) in children.iter_mut().enumerate() {
+            let child_old =
+                old.start.offset_by(&child.prepaint.start)..old.start.offset_by(&child.prepaint.end);
+            if !plan.contains(&ix) {
+                child.prepaint = child_old.start.offset_from(&part_old).offset_by(&part_new.offset_from(&start))
+                    ..child_old.end.offset_from(&part_old).offset_by(&part_new.offset_from(&start));
+                continue;
+            }
+            self.reuse_prepaint_part(cursor..child_old.start.clone(), &mut reuse);
+            // The view's own node is the last one before its output, pushed for it by its parent.
+            self.next_frame
+                .dispatch_tree
+                .reuse_open_at(child_old.start.dispatch_tree_index - 1, &mut reuse);
+            let child_start = self.prepaint_index();
+            prepaint_child(child, child_old.clone(), self);
+            let child_end = self.prepaint_index();
+            child.prepaint = child_start.offset_from(&start)..child_end.offset_from(&start);
+            cursor = child_old.end;
+            part_old = cursor.clone();
+            part_new = child_end;
+        }
+        self.reuse_prepaint_part(cursor..old.end.clone(), &mut reuse);
+        self.next_frame.dispatch_tree.reuse_close(&mut reuse);
+        if reuse.contains_focus() {
+            self.next_frame.focus = self.focus;
+        }
+        start..self.prepaint_index()
+    }

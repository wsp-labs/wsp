+
+impl RoundedClip<ScaledPixels> {
+    /// Whether the clip cuts any of `bounds` that its own bounds do not: where `bounds` reaches into a rounded
+    /// corner or past the clip's edges.
+    fn cuts(&self, bounds: &Bounds<ScaledPixels>) -> bool {
+        let clip = self.bounds;
+        let radii = self.corner_radii;
+        let corner = |x, y, radius: ScaledPixels| Bounds {
+            origin: point(x, y),
+            size: size(radius, radius),

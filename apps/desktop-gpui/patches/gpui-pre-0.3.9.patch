+/// Where a tooltip of `size` opens on an element at `owner`: on its `side`, centred along it, 4 px off, as a Base UI
+/// tooltip's positioner sets it; on the other side where the window has no room on that one, and shifted along the
+/// side to stay 5 px inside the window.
+fn tooltip_at(
+    owner: Bounds<Pixels>,
+    side: crate::TooltipSide,
+    size: Size<Pixels>,
+    window: Size<Pixels>,
+) -> Point<Pixels> {
+    const OFFSET: Pixels = px(4.);
+    const MARGIN: Pixels = px(5.);
+    let along = |centre: Pixels, length: Pixels, room: Pixels| {
+        (centre - length / 2.).min(room - MARGIN - length).max(MARGIN)
+    };
+    // The side asked for, else the other where only it has room.
+    let across = |before: Pixels, after: Pixels, length: Pixels, room: Pixels, first: bool| {
+        let (lead, other) = ((before - OFFSET - length), (after + OFFSET));
+        let lead_fits = lead >= MARGIN;
+        let other_fits = other + length <= room - MARGIN;
+        match (first, lead_fits, other_fits) {
+            (true, false, true) => other,
+            (true, _, _) => lead,
+            (false, true, false) => lead,
+            (false, _, _) => other,
+        }
+    };
+    match side {
+        crate::TooltipSide::Top | crate::TooltipSide::Bottom => point(
+            along(owner.center().x, size.width, window.width),
+            across(owner.top(), owner.bottom(), size.height, window.height, side == crate::TooltipSide::Top),
+        ),
+        crate::TooltipSide::Left | crate::TooltipSide::Right => point(
+            across(owner.left(), owner.right(), size.width, window.width, side == crate::TooltipSide::Left),
+            along(owner.center().y, size.height, window.height),
+        ),
+    }
+}

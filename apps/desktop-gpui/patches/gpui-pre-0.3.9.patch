+        &mut self,
+        range: std::ops::Range<usize>,
+    ) -> Option<Bounds<Pixels>> {
+        use crate::PlatformWindow as _;
+        let mut window = self.test_window(self.window);
+        let mut handler = window.take_input_handler()?;
+        let bounds = handler.bounds_for_range(range);
+        window.set_input_handler(handler);
+        bounds
+    }
+
+    /// The character the platform's input method finds at `point`, in the platform's pixels.
+    pub fn platform_character_index_for_point(&mut self, point: Point<Pixels>) -> Option<usize> {
+        use crate::PlatformWindow as _;
+        let mut window = self.test_window(self.window);
+        let mut handler = window.take_input_handler()?;
+        let index = handler.character_index_for_point(point);
+        window.set_input_handler(handler);
+        index
+    }

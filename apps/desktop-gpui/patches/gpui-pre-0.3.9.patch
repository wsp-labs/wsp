index 0000000..fdb9977
--- /dev/null
+++ b/src/frame_timing.rs
@@ -0,0 +1,106 @@
+//! Where a frame spent its time below the app's own work, for a bench's trace: the parts of a window's draw, the
+//! renderer's wait for a drawable and for its command buffer to be scheduled, and the GPU's own time, which a
+//! completion handler reports later. Recorded only while a trace has asked for it.
+
+use parking_lot::Mutex;
+use std::collections::VecDeque;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static ON: AtomicBool = AtomicBool::new(false);
+static PRESENTS: AtomicU64 = AtomicU64::new(0);
+static RECORDS: Mutex<VecDeque<Present>> = Mutex::new(VecDeque::new());
+static SPLIT: Mutex<DrawSplit> = Mutex::new(DrawSplit { before_ms: 0., roots_ms: 0., after_ms: 0. });
+
+/// So many presents kept, a minute's worth at 120 a second.
+const KEPT: usize = 8192;
+
+/// A renderer's present: its number, how long it waited for a drawable and for its commands to be scheduled, and
+/// once the GPU has run them, its time on the GPU.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Present {
+    /// Its number, from the first present the process made.
+    pub index: u64,
+    /// How long `nextDrawable` held the main thread.
+    pub drawable_wait_ms: f64,
+    /// How long waiting for the command buffer to be scheduled held it, when the present goes with a transaction.
+    pub scheduled_wait_ms: f64,
+    /// The GPU's own time on the commands, from `GPUStartTime` to `GPUEndTime`, once they have run.
+    pub gpu_ms: Option<f64>,
+}
+
+/// A window's last draw in three parts: what came before its roots (the invalidations, the input handler's return),
+/// laying out, prepainting and painting its roots, and what came after them (the input handler, the frame's swap, the
+/// focus listeners).
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct DrawSplit {
+    /// Before the roots.
+    pub before_ms: f64,
+    /// The roots' layout, prepaint and paint.
+    pub roots_ms: f64,
+    /// After the roots, to the drawn listeners.
+    pub after_ms: f64,
+}
+
+/// Starts or stops the recording.
+pub fn record(on: bool) {
+    ON.store(on, Ordering::SeqCst);
+    if !on {
+        RECORDS.lock().clear();
+    }
+}
+
+/// Whether a trace asked for the recording.
+pub fn recording() -> bool {
+    ON.load(Ordering::Relaxed)
+}
+
+/// A renderer starts a present, which it numbers.
+pub fn present_began() -> u64 {
+    let index = PRESENTS.fetch_add(1, Ordering::SeqCst) + 1;
+    let mut records = RECORDS.lock();
+    if records.len() == KEPT {
+        records.pop_front();
+    }
+    records.push_back(Present { index, ..Present::default() });
+    index
+}
+
+fn with(index: u64, f: impl FnOnce(&mut Present)) {
+    if let Some(present) = RECORDS.lock().iter_mut().rev().find(|p| p.index == index) {
+        f(present);
+    }
+}
+
+/// Present `index` waited `ms` for its drawable.
+pub fn drawable_waited(index: u64, ms: f64) {
+    with(index, |p| p.drawable_wait_ms = ms);
+}
+
+/// Present `index` waited `ms` for its commands to be scheduled.
+pub fn scheduled_waited(index: u64, ms: f64) {
+    with(index, |p| p.scheduled_wait_ms = ms);
+}
+
+/// The GPU ran present `index`'s commands in `ms`, from a completion handler on any thread.
+pub fn gpu_ran(index: u64, ms: f64) {
+    with(index, |p| p.gpu_ms = Some(ms));
+}
+
+/// The last present begun.
+pub fn last_present() -> u64 {
+    PRESENTS.load(Ordering::SeqCst)
+}
+
+/// Present `index`, while it is kept.
+pub fn present(index: u64) -> Option<Present> {
+    RECORDS.lock().iter().rev().find(|p| p.index == index).copied()
+}
+
+pub(crate) fn drew(split: DrawSplit) {
+    *SPLIT.lock() = split;
+}
+
+/// The parts of the last draw.
+pub fn last_draw() -> DrawSplit {
+    *SPLIT.lock()
+}

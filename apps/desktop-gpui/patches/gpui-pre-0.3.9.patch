+                );
+                continue;
+            }
+            self.reuse_paint(cursor..child_old.start.clone());
+            let child_start = self.paint_index();
+            paint_child(child, child_old.clone(), self);
+            let child_end = self.paint_index();
+            child.paint = Some(child_start.offset_from(&start)..child_end.offset_from(&start));
+            cursor = child_old.end;
+            part_old = cursor.clone();
+            part_new = child_end;
+        }
+        self.reuse_paint(cursor..old.end.clone());
+    }

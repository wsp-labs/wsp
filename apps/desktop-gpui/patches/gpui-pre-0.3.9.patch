+                corner(clip.left(), clip.top(), radii.top_left),
+                corner(clip.right() - radii.top_right, clip.top(), radii.top_right),
+                corner(
+                    clip.right() - radii.bottom_right,
+                    clip.bottom() - radii.bottom_right,
+                    radii.bottom_right,
+                ),
+                corner(clip.left(), clip.bottom() - radii.bottom_left, radii.bottom_left),
+            ]
+            .iter()
+            .any(|corner| corner.intersects(bounds))
+    }

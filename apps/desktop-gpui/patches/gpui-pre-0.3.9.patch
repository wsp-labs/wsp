+    /// Where the last frame drew `hitbox`, clipped to its content mask, and what it drew over it there: each hitbox
+    /// inserted after it that blocks the mouse, and the tooltip. None when the frame did not draw it. A native view laid
+    /// over that hitbox cuts these out of itself so the overlays show.
+    pub fn drawn_over(&self, hitbox: HitboxId) -> Option<(Bounds<Pixels>, Vec<Bounds<Pixels>>)> {
+        let hitboxes = &self.rendered_frame.hitboxes;
+        let at = hitboxes.iter().position(|h| h.id == hitbox)?;
+        let under = hitboxes[at].bounds.intersect(&hitboxes[at].content_mask.bounds);
+        let over = hitboxes[at + 1..]
+            .iter()
+            .filter(|h| h.behavior == HitboxBehavior::BlockMouse)
+            .map(|h| h.bounds.intersect(&h.content_mask.bounds))
+            .chain(self.tooltip_bounds.as_ref().map(|t| t.bounds))
+            .map(|b| b.intersect(&under))
+            .filter(|b| !b.is_empty())
+            .collect();
+        Some((under, over))
+    }

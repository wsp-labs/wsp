+    /// Whether a line may break before `c`, the character after `before` and `prev`: after a run of spaces; between two
+    /// printable ASCII characters only where Blink's table allows it (`FillAscii` in Chromium's
+    /// third_party/blink/renderer/platform/text/character_property_data_generator.cc, with `ShouldBreakFast` in
+    /// text_break_iterator.cc for `-` before a digit); elsewhere before any character that is not a word character.
+    pub(crate) fn can_break_before(before: char, prev: char, c: char) -> bool {
+        if c == ' ' {
+            return false;
+        }
+        if prev == ' ' {
+            return true;
+        }
+        let ascii = |c: char| ('!'..='\u{7f}').contains(&c);
+        if !(ascii(prev) && ascii(c)) {
+            // CJK may not be space separated, e.g.: `Hello world你好世界`
+            return !Self::is_word_char(c);
+        }
+        if matches!(prev, '$' | '\'' | '(' | '/' | '0'..='9' | '<' | '@' | 'A'..='Z' | '[' | '^'..='`' | 'a'..='z' | '{' | '\u{7f}')
+            || matches!(c, '!' | ')' | ',' | '.' | '/' | ':' | ';' | '?' | ']' | '}')
+        {
+            return false;
+        }
+        match prev {
+            '-' if c.is_ascii_digit() => before.is_ascii_alphanumeric(),
+            '-' => c != '$',
+            '?' => !matches!(c, '"' | '\''),
+            _ => matches!(c, '(' | '<' | '[' | '{'),
+        }
+    }

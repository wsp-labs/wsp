+impl LineLayoutIndex {
+    /// This index as a count of layouts past `base`, an index at or before it of the same generation.
+    pub(crate) fn offset_from(&self, base: &Self) -> Self {
+        Self {
+            font_generation: self.font_generation,
+            lines_index: self.lines_index - base.lines_index,
+            wrapped_lines_index: self.wrapped_lines_index - base.wrapped_lines_index,
+            lines_by_hash_index: self.lines_by_hash_index - base.lines_by_hash_index,
+            wrapped_lines_by_hash_index: self.wrapped_lines_by_hash_index
+                - base.wrapped_lines_by_hash_index,
+        }
+    }
+
+    /// The index `offset` layouts past this one.
+    pub(crate) fn offset_by(&self, offset: &Self) -> Self {
+        Self {
+            font_generation: self.font_generation,
+            lines_index: self.lines_index + offset.lines_index,
+            wrapped_lines_index: self.wrapped_lines_index + offset.wrapped_lines_index,
+            lines_by_hash_index: self.lines_by_hash_index + offset.lines_by_hash_index,
+            wrapped_lines_by_hash_index: self.wrapped_lines_by_hash_index
+                + offset.wrapped_lines_by_hash_index,
+        }
+    }
+
+    /// Whether both indices count layouts made with the same fonts.
+    pub(crate) fn same_generation(&self, other: &Self) -> bool {
+        self.font_generation == other.font_generation
+    }
+}

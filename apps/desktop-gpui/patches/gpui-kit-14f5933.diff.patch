+/// The empty side of a split row with a look: the number lane in its fill,
+/// the gap, and pierre's buffer stripes over the code column, 2 px wide every
+/// 8 px, rising to the right.
+fn buffer_row(file: usize, look: DiffLook, code: &CodePresentation) -> impl IntoElement {
+    let stripe = look.buffer_stripe;
+    h_flex()
+        .flex_1()
+        .min_h(code.row_height)
+        .items_stretch()
+        .when(code.line_number, |this| {
+            this.child(
+                div()
+                    .flex_shrink_0()
+                    .w(code.lane_width(file))
+                    .bg(look.buffer_number),
+            )
+            .child(div().flex_shrink_0().w(look.gap))
+        })
+        .child(
+            gpui::canvas(
+                |_, _, _| {},
+                move |bounds, _, window, _| {
+                    let (w, h) = (bounds.size.width, bounds.size.height);
+                    let mut path = gpui::PathBuilder::fill();
+                    // Where x + y is 5.25 to 7.25 px into each 8, as Chromium samples pierre's tile.
+                    let mut k = px(-2.75);
+                    while k < w + h {
+                        let at = |x: Pixels, y: Pixels| point(bounds.left() + x, bounds.top() + y);
+                        path.move_to(at(k, px(0.)));
+                        path.line_to(at(k + px(2.), px(0.)));
+                        path.line_to(at(k + px(2.) - h, h));
+                        path.line_to(at(k - h, h));
+                        path.close();
+                        k += px(8.);
+                    }
+                    if let Ok(path) = path.build() {
+                        window.with_content_mask(Some(gpui::ContentMask { bounds }), |window| {
+                            window.paint_path(path, stripe)
+                        });
+                    }
+                },
+            )
+            .flex_1(),
+        )

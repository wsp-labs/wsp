+    /// blocks longest out of view past [`SYNTAX_BLOCKS_KEPT`]. Call it after
+    /// the list's prepaint.
+    pub(crate) fn prepare_syntax_near_view(
+        &mut self,
+        theme: &Arc<HighlightTheme>,
+        cx: &mut Context<Self>,
+    ) {
+        if !self.presentation_options.syntax_near_view {
+            return;
+        }
+        if !self
+            .syntax_theme
+            .as_ref()
+            .is_some_and(|styled| Arc::ptr_eq(styled, theme))
+        {
+            self.syntax = Rc::default();
+            self.syntax_seen.clear();
+            self.preparing_syntax = false;
+            self._syntax = Task::ready(());
+            self.syntax_theme = Some(theme.clone());
+        }
+        let top = self.list.logical_scroll_top().item_ix;
+        let row = f32::from(self.row_height.unwrap_or(px(20.))).max(1.);
+        let shown = (f32::from(self.viewport.height) / row).ceil() as usize + 1;
+        let margin = SYNTAX_BLOCK / 2;
+        let end = (top + shown + margin).min(self.rows.len());
+        let mut near = Vec::new();
+        for ix in (top.min(end)..end).chain((top.saturating_sub(margin)..top.min(end)).rev()) {
+            let DisplayRow::Code {
+                file,
+                original,
+                modified,
+                ..
+            } = self.rows[ix]
+            else {
+                continue;
+            };
+            let sides = match (self.mode, original, modified) {
+                (DiffMode::Split, original, modified) => [
+                    original.map(|ix| (DiffSide::Original, ix)),
+                    modified.map(|ix| (DiffSide::Modified, ix)),
+                ],
+                (DiffMode::Unified, _, Some(modified)) => {
+                    [Some((DiffSide::Modified, modified)), None]
+                }
+                (DiffMode::Unified, original, None) => {
+                    [original.map(|ix| (DiffSide::Original, ix)), None]
+                }
+            };
+            for (side, line) in sides.into_iter().flatten() {
+                let key = BlockKey::of(file, side, line);
+                if !near.contains(&key) {
+                    near.push(key);
+                }
+            }
+        }
+        self.syntax_clock += 1;
+        for key in &near {
+            self.syntax_seen.insert(*key, self.syntax_clock);
+        }
+        if self.preparing_syntax {
+            return;
+        }
+        let pending = near
+            .into_iter()
+            .filter(|key| !self.syntax.contains_key(key))
+            .map(|key| (key, self.files[key.file].clone()))
+            .collect::<Vec<_>>();
+        if pending.is_empty() {
+            return;
+        }
+        let generation = self.presentation_generation;
+        let max_line_length = self.presentation_options.syntax_max_line_length;
+        let mut parses = Some(self.parses.take().unwrap_or_default());
+        let theme = theme.clone();
+        let test = cx.background_executor().is_test();
+        self.preparing_syntax = true;
+        self._syntax = cx.spawn(async move |this, cx| {
+            for (key, file) in pending {
+                let mut moved = parses.take();
+                let theme = theme.clone();
+                let prepare = move || {
+                    let block = SyntaxBlock::prepare(
+                        &file,
+                        key,
+                        max_line_length,
+                        moved.get_or_insert_default(),
+                        &*theme,
+                    );
+                    (block, moved)
+                };
+                // A test's scheduler refuses wakes from a thread it does not run.
+                let (block, returned) = if test {
+                    cx.background_spawn(async move { prepare() }).await
+                } else {
+                    let (send, done) = smol::channel::bounded(1);
+                    on_syntax_thread(move || {
+                        // Files replaced or a view dropped since this was queued.
+                        if send.receiver_count() > 0 {
+                            _ = send.send_blocking(prepare());
+                        }
+                    });
+                    match done.recv().await {
+                        Ok(prepared) => prepared,
+                        // The preparation panicked: the block stays plain and is not tried again.
+                        Err(_) => (SyntaxBlock::plain(), None),
+                    }
+                };
+                parses = returned;
+                let current = this.update(cx, |state, cx| {
+                    if state.presentation_generation != generation {
+                        return false;
+                    }
+                    Rc::make_mut(&mut state.syntax).insert(key, Arc::new(block));
+                    state.syntax_prepared += 1;
+                    cx.notify();
+                    true
+                });
+                if !matches!(current, Ok(true)) {
+                    return;
+                }
+            }
+            if let Some(parses) = &mut parses {
+                parses.release();
+            }
+            _ = this.update(cx, |state, _| {
+                state.parses = parses;
+                state.preparing_syntax = false;
+                state.forget_syntax_out_of_view();
+            });
+        });
+    }
+
+    /// Blocks seen in the last frame are near the view and stay, however many.
+    fn forget_syntax_out_of_view(&mut self) {
+        let over = self.syntax.len().saturating_sub(SYNTAX_BLOCKS_KEPT);
+        if over > 0 {
+            let mut by_age = self
+                .syntax
+                .keys()
+                .map(|key| (self.syntax_seen.get(key).copied().unwrap_or(0), *key))
+                .filter(|(seen, _)| *seen < self.syntax_clock)
+                .collect::<Vec<_>>();
+            by_age.sort_unstable_by_key(|(seen, _)| *seen);
+            let syntax = Rc::make_mut(&mut self.syntax);
+            for (_, key) in by_age.into_iter().take(over) {
+                syntax.remove(&key);
+            }
+        }
+        let syntax = &self.syntax;
+        self.syntax_seen.retain(|key, _| syntax.contains_key(key));
     }
 

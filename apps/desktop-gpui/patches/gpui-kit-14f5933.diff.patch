+                    (Some(ix), Some(_)) => (' ', DiffSide::Original, ix),
+                    (Some(ix), None) => ('-', DiffSide::Original, ix),
+                    (None, Some(ix)) => ('+', DiffSide::Modified, ix),
+                    (None, None) => continue,
+                };
+                let text = &self.source(side)[self.lines(side)[ix].source()];
+                out.push(tag);
+                out.push_str(text);
+                if !text.ends_with('\n') {
+                    out.push_str("\n\\ No newline at end of file\n");
+                }
+            }
+        }
+        out
+    }

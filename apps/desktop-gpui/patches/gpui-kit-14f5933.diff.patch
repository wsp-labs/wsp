+    pub fn to_patch(&self) -> String {
+        let inner = &self.inner;
+        let (old, new) = (self.original_path(), self.modified_path());
+        let path = |side: Option<&SharedString>, prefix: &str| {
+            side.map_or("/dev/null".to_owned(), |path| format!("{prefix}{path}"))
+        };
+        let mut out = format!(
+            "diff --git a/{} b/{}\n",
+            old.or(new).map_or("", |p| p.as_str()),
+            new.or(old).map_or("", |p| p.as_str()),
+        );
+        for header in &inner.extended_headers {
+            out.push_str(header);
+            out.push('\n');
+        }
+        if inner.hunks.is_empty() {
+            return out;
+        }
+        out.push_str(&format!(
+            "--- {}\n+++ {}\n",
+            path(old, "a/"),
+            path(new, "b/")
+        ));
+        let mut lines = inner.patch_lines.iter().peekable();
+        for hunk in &inner.hunks {
+            out.push_str(&hunk.label);
+            out.push('\n');
+            while let Some(line) = lines.next_if(|line| {
+                line.original.is_some_and(|ix| hunk.original.contains(&ix))
+                    || line.modified.is_some_and(|ix| hunk.modified.contains(&ix))

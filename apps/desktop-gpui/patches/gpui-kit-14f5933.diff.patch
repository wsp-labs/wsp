+                        Ok(prepared) => prepared,
+                        // The preparation panicked: the block stays plain and is not tried again.
+                        Err(_) => (SyntaxBlock::plain(), None),
+                    }
+                };
+                parses = returned;
+                let current = this.update(cx, |state, cx| {
+                    if state.presentation_generation != generation {
+                        return false;
+                    }
+                    Rc::make_mut(&mut state.syntax).insert(key, Arc::new(block));
+                    state.syntax_prepared += 1;
+                    cx.notify();
+                    true
+                });
+                if !matches!(current, Ok(true)) {
+                    return;
+                }
+            }
+            if let Some(parses) = &mut parses {
+                parses.release();
+            }
+            _ = this.update(cx, |state, _| {
+                state.parses = parses;
+                state.preparing_syntax = false;
+                state.forget_syntax_out_of_view();
+            });
+        });
+    }
+
+    /// Blocks seen in the last frame are near the view and stay, however many.
+    fn forget_syntax_out_of_view(&mut self) {
+        let over = self.syntax.len().saturating_sub(SYNTAX_BLOCKS_KEPT);
+        if over > 0 {
+            let mut by_age = self
+                .syntax
+                .keys()
+                .map(|key| (self.syntax_seen.get(key).copied().unwrap_or(0), *key))
+                .filter(|(seen, _)| *seen < self.syntax_clock)
+                .collect::<Vec<_>>();
+            by_age.sort_unstable_by_key(|(seen, _)| *seen);
+            let syntax = Rc::make_mut(&mut self.syntax);
+            for (_, key) in by_age.into_iter().take(over) {
+                syntax.remove(&key);
+            }
+        }
+        let syntax = &self.syntax;
+        self.syntax_seen.retain(|key, _| syntax.contains_key(key));
     }
 

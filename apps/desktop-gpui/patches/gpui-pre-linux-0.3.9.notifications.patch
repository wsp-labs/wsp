+    #[test]
+    fn only_the_last_fifty_notifications_are_held() {
+        let mut showing = Showing::new();
+        for id in 1..=101 {
+            hold(&mut showing, ":1.7", id, shown(&format!("line {id}")));
+        }
+        assert_eq!(showing.len(), HELD);
+        assert!(release(&mut showing, ":1.7", 51).is_none());
+        assert_eq!(release(&mut showing, ":1.7", 52).unwrap().tag, "line 52");
+        assert_eq!(release(&mut showing, ":1.7", 101).unwrap().tag, "line 101");
+        assert_eq!(showing.len(), HELD - 2);
+    }
+
+    #[test]
+    fn a_notification_is_released_only_by_the_server_that_showed_it() {
+        let mut showing = Showing::new();
+        hold(&mut showing, ":1.7", 3, shown("line"));
+        assert!(release(&mut showing, ":1.9", 3).is_none());
+        assert_eq!(showing.len(), 1);
+        assert_eq!(release(&mut showing, ":1.7", 3).unwrap().tag, "line");
+        assert!(showing.is_empty());
+    }

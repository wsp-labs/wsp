+/// Sends each notification over one session-bus connection and reports the
+/// response to each, until the platform goes or the connection is lost; the
+/// next notification after a loss connects again.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+async fn serve(
+    mut shows: mpsc::UnboundedReceiver<Shown>,
+    responses: mpsc::UnboundedSender<SystemNotificationResponse>,
+) {
+    if let Err(error) = serve_on_bus(&mut shows, &responses).await {
+        log::warn!("system notifications lost the session bus: {error}");
+    }
+}
+
+#[cfg(any(feature = "wayland", feature = "x11"))]
+use ashpd::zbus;
+
+#[cfg(any(feature = "wayland", feature = "x11"))]
+const NOTIFICATIONS: &str = "org.freedesktop.Notifications";
+
+#[cfg(any(feature = "wayland", feature = "x11"))]
+async fn serve_on_bus(
+    shows: &mut mpsc::UnboundedReceiver<Shown>,
+    responses: &mpsc::UnboundedSender<SystemNotificationResponse>,
+) -> zbus::Result<()> {
+    let connection = zbus::Connection::session().await?;
+    let bus = zbus::fdo::DBusProxy::new(&connection).await?;
+    for member in ["ActionInvoked", "NotificationClosed"] {
+        let rule = zbus::MatchRule::builder()
+            .msg_type(zbus::message::Type::Signal)
+            .interface(NOTIFICATIONS)?
+            .member(member)?
+            .build();
+        bus.add_match_rule(rule).await?;
+    }
+    // Replies and signals arrive in the order the server sent them, so a
+    // notification's id is known before any signal about it is read.
+    let mut messages = zbus::MessageStream::from(&connection);
+    let mut sending = HashMap::new();
+    let mut showing = Showing::new();
+    loop {
+        futures::select! {
+            shown = shows.next() => {
+                let Some(shown) = shown else { return Ok(()) };
+                match notify_call(&shown.notification) {
+                    Ok(call) => {
+                        if let Err(error) = connection.send(&call).await {
+                            log::warn!("failed to show system notification: {error}");
+                            return Err(error);
+                        }
+                        sending.insert(call.primary_header().serial_num(), shown);
+                    }
+                    Err(error) => log::warn!("failed to show system notification: {error}"),
+                }
+            }
+            message = messages.next() => match message {
+                Some(Ok(message)) => heard(&message, &mut sending, &mut showing, responses),
+                Some(Err(_)) => {}
+                None => return Ok(()),
+            },
+        }
+    }
+}
+
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn notify_call(notification: &notify_rust::Notification) -> zbus::Result<zbus::Message> {
+    zbus::Message::method_call("/org/freedesktop/Notifications", "Notify")?
+        .destination(NOTIFICATIONS)?
+        .interface(NOTIFICATIONS)?
+        .build(&(
+            &notification.appname,
+            0u32,
+            &notification.icon,
+            &notification.summary,
+            &notification.body,
+            &notification.actions,
+            HashMap::<&str, zbus::zvariant::Value>::new(),
+            i32::from(notification.timeout),
+        ))
+}
+
+/// Takes a reply to a `Notify` call or a signal about a notification.
+#[cfg(any(feature = "wayland", feature = "x11"))]
+fn heard(
+    message: &zbus::Message,
+    sending: &mut HashMap<std::num::NonZeroU32, Shown>,
+    showing: &mut Showing,
+    responses: &mpsc::UnboundedSender<SystemNotificationResponse>,
+) {
+    use zbus::message::Type;
+
+    let header = message.header();
+    // Signals count only from the server that answered the notification's
+    // `Notify`: any client on the bus may send one.
+    let Some(sender) = header.sender().map(|sender| sender.as_str()) else {
+        return;
+    };
+    match header.message_type() {
+        Type::MethodReturn | Type::Error => {
+            let Some(shown) = header
+                .reply_serial()
+                .and_then(|serial| sending.remove(&serial))
+            else {
+                return;
+            };
+            let id = match header.message_type() {
+                Type::MethodReturn => message.body().deserialize::<u32>(),
+                _ => Err(zbus::Error::from(message.clone())),
+            };
+            match id {
+                Ok(id) => hold(showing, sender, id, shown),
+                Err(error) => log::warn!("failed to show system notification: {error}"),
+            }
+        }
+        Type::Signal
+            if header
+                .interface()
+                .is_some_and(|i| i.as_str() == NOTIFICATIONS) =>
+        {
+            match header.member().map(|member| member.as_str()) {
+                Some("ActionInvoked") => {
+                    let Ok((id, transport_id)) = message.body().deserialize::<(u32, String)>()
+                    else {
+                        return;
+                    };
+                    let Some(shown) = release(showing, sender, id) else {
+                        return;
+                    };
+                    let Some(action_id) = response_action_id(&transport_id, &shown.action_ids)
+                    else {
+                        log::warn!("system notification returned unknown action {transport_id:?}");
+                        return;
+                    };
+                    responses
+                        .unbounded_send(SystemNotificationResponse {
+                            tag: shown.tag,
+                            action_id,
+                        })
+                        .ok();
+                }
+                Some("NotificationClosed") => {
+                    if let Ok((id, _reason)) = message.body().deserialize::<(u32, u32)>() {
+                        release(showing, sender, id);
+                    }
+                }
+                _ => {}
+            }
+        }
+        _ => {}
+    }
+}

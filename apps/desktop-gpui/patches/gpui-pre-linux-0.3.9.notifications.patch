+
+/// How many shown notifications a response is still heard for; older ones
+/// only age out of the shade.
+const HELD: usize = 50;
+
+/// Each shown notification by the server's unique name and its id, oldest first.
+type Showing = VecDeque<(String, u32, Shown)>;
+
+fn hold(showing: &mut Showing, server: &str, id: u32, shown: Shown) {
+    showing.push_back((server.to_owned(), id, shown));
+    if showing.len() > HELD {
+        showing.pop_front();
+    }
+}
+
+fn release(showing: &mut Showing, server: &str, id: u32) -> Option<Shown> {
+    let index = showing
+        .iter()
+        .position(|(held_by, held_id, _)| held_by == server && *held_id == id)?;
+    showing.remove(index).map(|(_, _, shown)| shown)
 }
 

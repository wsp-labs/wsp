+        let far_weight = if near < radius { weight(near + 1) } else { 0.0 };
+        let pair_weight = near_weight + far_weight;
+        if pair_weight == 0.0 {
+            break;
+        }
+        let offset = (near as f32 * near_weight + (near + 1) as f32 * far_weight) / pair_weight;

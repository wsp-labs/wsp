diff --git b/src/shaders_backdrop_blur.wgsl b/src/shaders_backdrop_blur.wgsl
new file mode 100644
index 0000000..7d686fc
--- /dev/null
+++ b/src/shaders_backdrop_blur.wgsl
@@ -0,0 +1,134 @@
+// --- backdrop blurs --- //
+
+struct BackdropBlur {
+    order: u32,
+    opacity: f32,
+    bounds: Bounds,
+    content_mask: Bounds,
+    corner_radii: Corners,
+    blur_radius: f32,
+    saturation: f32,
+    rounded_clip: u32,
+    pad: u32,
+}
+
+// `region` is the blur's bounds in whole target pixels, copied to the scratch textures' origin and blurred there
+// downscaled by `scale` to `scaled_size`. `taps[0]` is the kernel's center; every other tap is one bilinear sample
+// standing for two kernel taps, used on both sides.
+struct BackdropBlurPass {
+    blur: BackdropBlur,
+    region: Bounds,
+    scaled_size: vec2<f32>,
+    scale: f32,
+    tap_count: u32,
+    encode_srgb: u32,
+    pad: u32,
+    taps: array<vec2<f32>, 7>,
+}
+
+@group(1) @binding(0) var<storage, read> b_backdrop_blurs: array<BackdropBlurPass>;
+
+struct BackdropBlurVarying {
+    @builtin(position) position: vec4<f32>,
+    @location(0) @interpolate(flat) blur_id: u32,
+    @location(3) clip_distances: vec4<f32>,
+}
+
+// Mirrors like a MirrorRepeat sampler on a texture of exactly `size` texels, which the scratch textures are not.
+fn mirror_into_region(position: f32, size: f32) -> f32 {
+    let wrapped = position - 2.0 * size * floor(position / (2.0 * size));
+    return clamp(select(wrapped, 2.0 * size - wrapped, wrapped > size), 0.5, size - 0.5);
+}
+
+fn backdrop_blur_sample(position: vec2<f32>, size: vec2<f32>) -> vec3<f32> {
+    let mirrored = vec2<f32>(mirror_into_region(position.x, size.x), mirror_into_region(position.y, size.y));
+    return textureSampleLevel(t_sprite, s_sprite, mirrored / vec2<f32>(textureDimensions(t_sprite)), 0.0).rgb;
+}
+
+fn backdrop_blur_along(position: vec2<f32>, direction: vec2<f32>, blur_id: u32) -> vec4<f32> {
+    let size = b_backdrop_blurs[blur_id].scaled_size;
+    var color = backdrop_blur_sample(position, size) * b_backdrop_blurs[blur_id].taps[0].y;
+    for (var i = 1u; i < b_backdrop_blurs[blur_id].tap_count; i += 1u) {
+        let tap = b_backdrop_blurs[blur_id].taps[i];
+        color += (backdrop_blur_sample(position + direction * tap.x, size) +
+            backdrop_blur_sample(position - direction * tap.x, size)) * tap.y;
+    }
+    return vec4<f32>(color, 1.0);
+}
+
+// The Filter Effects saturate matrix, applied to the encoded values as browsers do.
+fn saturate_color(color: vec3<f32>, saturation: f32) -> vec3<f32> {
+    let s = saturation;
+    return saturate(vec3<f32>(
+        dot(vec3<f32>(0.213 + 0.787 * s, 0.715 - 0.715 * s, 0.072 - 0.072 * s), color),
+        dot(vec3<f32>(0.213 - 0.213 * s, 0.715 + 0.285 * s, 0.072 - 0.072 * s), color),
+        dot(vec3<f32>(0.213 - 0.213 * s, 0.715 - 0.715 * s, 0.072 + 0.928 * s), color),
+    ));
+}
+
+// Covers the viewport, which is set to the scaled region of a scratch texture.
+@vertex
+fn vs_backdrop_blur_scratch(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> BackdropBlurVarying {
+    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));
+    var out = BackdropBlurVarying();
+    out.position = vec4<f32>(unit_vertex * vec2<f32>(2.0, -2.0) + vec2<f32>(-1.0, 1.0), 0.0, 1.0);
+    out.blur_id = instance_id;
+    out.clip_distances = vec4<f32>(1.0);
+    return out;
+}
+
+// Averages each `scale` by `scale` block, one bilinear sample per 2 by 2 pixels.
+@fragment
+fn fs_backdrop_blur_downsample(input: BackdropBlurVarying) -> @location(0) vec4<f32> {
+    let scale = b_backdrop_blurs[input.blur_id].scale;
+    let size = b_backdrop_blurs[input.blur_id].region.size;
+    let block = floor(input.position.xy) * scale;
+    var color = vec3<f32>(0.0);
+    for (var y = 1.0; y < scale; y += 2.0) {
+        for (var x = 1.0; x < scale; x += 2.0) {
+            color += backdrop_blur_sample(block + vec2<f32>(x, y), size);
+        }
+    }
+    return vec4<f32>(color * (4.0 / (scale * scale)), 1.0);
+}
+
+@fragment
+fn fs_backdrop_blur_horizontal(input: BackdropBlurVarying) -> @location(0) vec4<f32> {
+    return backdrop_blur_along(input.position.xy, vec2<f32>(1.0, 0.0), input.blur_id);
+}
+
+@fragment
+fn fs_backdrop_blur_vertical(input: BackdropBlurVarying) -> @location(0) vec4<f32> {
+    return backdrop_blur_along(input.position.xy, vec2<f32>(0.0, 1.0), input.blur_id);
+}
+
+@vertex
+fn vs_backdrop_blur_composite(@builtin(vertex_index) vertex_id: u32, @builtin(instance_index) instance_id: u32) -> BackdropBlurVarying {
+    let unit_vertex = vec2<f32>(f32(vertex_id & 1u), 0.5 * f32(vertex_id & 2u));
+    let region = b_backdrop_blurs[instance_id].region;
+    var out = BackdropBlurVarying();
+    out.position = to_device_position(unit_vertex, region);
+    out.blur_id = instance_id;
+    out.clip_distances = distance_from_clip_rect(unit_vertex, region, b_backdrop_blurs[instance_id].blur.content_mask);
+    return out;
+}
+
+@fragment
+fn fs_backdrop_blur_composite(input: BackdropBlurVarying) -> @location(0) vec4<f32> {
+    if (any(input.clip_distances < vec4<f32>(0.0))) {
+        return vec4<f32>(0.0);
+    }
+
+    let blur = b_backdrop_blurs[input.blur_id].blur;
+    let region = b_backdrop_blurs[input.blur_id].region;
+    let scaled_position = (input.position.xy - region.origin) / b_backdrop_blurs[input.blur_id].scale;
+    let blurred = backdrop_blur_sample(scaled_position, b_backdrop_blurs[input.blur_id].scaled_size);
+    var color = saturate_color(blurred, blur.saturation);
+    // An sRGB target encodes what it stores, and the blur already worked on encoded values.
+    if (b_backdrop_blurs[input.blur_id].encode_srgb != 0u) {
+        color = srgb_to_linear(color);
+    }
+    let alpha = saturate(0.5 - quad_sdf(input.position.xy, blur.bounds, blur.corner_radii)) *
+        rounded_clip_alpha(input.position.xy, blur.rounded_clip) * blur.opacity;
+    return blend_color(vec4<f32>(color, 1.0), alpha);
+}

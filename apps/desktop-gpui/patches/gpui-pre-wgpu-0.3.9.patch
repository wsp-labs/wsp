+    /// One axis of a CSS backdrop blur: a Gaussian of standard deviation `sigma` over `values`,
+    /// mirrored at their edges.
+    #[cfg(target_os = "linux")]
+    fn reference_blur(values: &[f64], sigma: f64) -> Vec<f64> {
+        let radius = (3.0 * sigma).ceil() as i64;
+        let weights: Vec<f64> = (-radius..=radius)
+            .map(|k| (-(k * k) as f64 / (2.0 * sigma * sigma)).exp())
+            .collect();
+        let total: f64 = weights.iter().sum();
+        let len = values.len() as i64;
+        (0..len)
+            .map(|i| {
+                (-radius..=radius)
+                    .zip(&weights)
+                    .map(|(k, weight)| {
+                        let mut j = (i + k).rem_euclid(2 * len);
+                        if j >= len {
+                            j = 2 * len - 1 - j;
+                        }
+                        weight * values[j as usize]
+                    })
+                    .sum::<f64>()
+                    / total
+            })
+            .collect()
+    }

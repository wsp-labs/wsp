+/// Fills `taps` with a normalized Gaussian of standard deviation `sigma` reaching ceil(3 sigma)
+/// pixels each way, as (offset, weight): the center, then one bilinear sample per two neighboring
+/// pixels. Returns the tap count.
+fn backdrop_blur_taps(sigma: f32, taps: &mut [[f32; 2]; BACKDROP_BLUR_MAX_TAPS]) -> u32 {
+    let radius = ((3.0 * sigma).ceil().max(0.0) as usize).min(2 * (BACKDROP_BLUR_MAX_TAPS - 1));
+    let weight = |offset: usize| (-((offset * offset) as f32) / (2.0 * sigma * sigma)).exp();
+    let total = 1.0 + 2.0 * (1..=radius).map(weight).sum::<f32>();
+    taps[0] = [0.0, 1.0 / total];
+    let mut count = 1;
+    for near in (1..=radius).step_by(2) {
+        let near_weight = weight(near);
+        let far_weight = if near < radius { weight(near + 1) } else { 0.0 };
+        let pair_weight = near_weight + far_weight;
+        if pair_weight == 0.0 {
+            break;
+        }
+        let offset = (near as f32 * near_weight + (near + 1) as f32 * far_weight) / pair_weight;
+        taps[count] = [offset, pair_weight / total];
+        count += 1;
+    }
+    count as u32

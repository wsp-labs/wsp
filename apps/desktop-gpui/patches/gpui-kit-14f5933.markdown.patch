+                .use_keyed_state(
+                    block_element_id("codeblock-hscroll", self.span, options.ix),
+                    cx,
+                    |_, _| ScrollHandle::default(),
+                )
+                .read(cx)
+                .clone();
+            // Measured by the last frame, as the scrollbar's lane only shows
+            // while the code is wider than the block.

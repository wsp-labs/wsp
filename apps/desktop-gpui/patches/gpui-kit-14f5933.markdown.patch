+/// The room a code span's frame leaves on each side of its text: the style's,
+/// or the default for a span whose highlight carries no frame.
+pub(super) fn code_padding(highlights: &[(Range<usize>, InlineHighlight)]) -> Pixels {
+    highlights
+        .iter()
+        .find(|(_, highlight)| highlight.font_size_scale.is_some())
+        .map_or(Pixels::ZERO, |(_, highlight)| {
+            highlight
+                .code
+                .as_ref()
+                .map_or(px(INLINE_CODE_PADDING), |frame| frame.padding_x)
+        })
+}
+
+/// The font size of a run `scale` times the flow's: a code span's frame may
+/// fix it instead, as CSS's `rem` sizes do.
+pub(super) fn segment_size(
+    font_size: Pixels,
+    scale: f32,
+    highlights: &[(Range<usize>, InlineHighlight)],
+) -> Pixels {
+    highlights
+        .iter()
+        .find_map(|(_, highlight)| highlight.code.as_ref().and_then(|frame| frame.size))
+        .unwrap_or(font_size * scale)
+}
+
+/// The icon of the web link that starts at byte `start` of an item, if one does.
+fn icon_at(
+    links: &[(Range<usize>, LinkMark)],
+    highlights: &[(Range<usize>, InlineHighlight)],
+    start: usize,
+) -> Option<LinkIcon> {
+    if !links.iter().any(|(range, _)| range.start == start) {
+        return None;
+    }
+    highlights
+        .iter()
+        .find(|(range, highlight)| range.contains(&start) && highlight.icon.is_some())
+        .and_then(|(_, highlight)| highlight.icon.clone())
+}
+
+/// [`text_size_ranges`], cut again where a link with an icon starts, so the
+/// icon opens a fragment of its own.
+fn flow_segments(
+    text_len: usize,
+    highlights: &[(Range<usize>, InlineHighlight)],
+    links: &[(Range<usize>, LinkMark)],
+) -> Vec<(Range<usize>, f32)> {
+    let mut cuts = links
+        .iter()
+        .map(|(range, _)| range.start)
+        .filter(|&start| icon_at(links, highlights, start).is_some())
+        .collect::<Vec<_>>();
+    cuts.sort_unstable();
+    let mut segments = Vec::new();
+    for (range, scale) in text_size_ranges(text_len, highlights) {
+        let mut start = range.start;
+        for &cut in cuts
+            .iter()
+            .filter(|&&cut| range.start < cut && cut < range.end)
+        {
+            segments.push((start..cut, scale));
+            start = cut;
+        }
+        segments.push((start..range.end, scale));
+    }
+    segments
+}

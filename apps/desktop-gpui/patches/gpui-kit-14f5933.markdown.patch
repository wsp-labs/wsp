+/// Takes GitHub's alert marker off a quote's first line: `[!NOTE]` and the other four
+/// kinds, in any case, alone on that line. Something else on the marker's line leaves an
+/// ordinary quote, as GitHub reads it.
+fn take_alert_marker(children: &mut Vec<Node>) -> Option<crate::text::AlertKind> {
+    let Some(Node::Paragraph(paragraph)) = children.first_mut() else {
+        return None;
+    };
+    let only_child = paragraph.children.len() == 1;
+    let Some(Node::Text(text)) = paragraph.children.first_mut() else {
+        return None;
+    };
+    let rest = text.value.strip_prefix("[!")?;
+    let close = rest.find(']')?;
+    let kind = crate::text::AlertKind::from_marker(&rest[..close])?;
+    let after = &rest[close + 1..];
+    let line_end = if after.starts_with("\r\n") {
+        2
+    } else if after.starts_with('\n') {
+        1
+    } else if after.is_empty() {
+        0
+    } else {
+        return None;
+    };
+    let marker = 2 + close + 1 + line_end;
+    if text.value.len() > marker {
+        text.value = text.value[marker..].to_string();
+        if let Some(position) = text.position.as_mut() {
+            position.start.offset += marker;
+        }
+    } else if line_end > 0 || only_child {
+        paragraph.children.remove(0);
+        if paragraph.children.is_empty() {
+            children.remove(0);
+        }
+    } else {
+        return None;
+    }
+    Some(kind)
+}

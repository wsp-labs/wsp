+/// Whether a line of `text` opens a footnote definition, `^ {0,3}\[\^[^\]]+\]:`.
+fn defines_footnote(text: &str) -> bool {
+    text.lines().any(|line| {
+        let body = line.trim_start_matches(' ');
+        line.len() - body.len() <= 3

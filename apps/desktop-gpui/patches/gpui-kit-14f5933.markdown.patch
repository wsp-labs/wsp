+/// How a list marks its items, as CSS's `list-style-type` names them.
+#[derive(Clone, Debug, PartialEq)]
+pub enum ListStyleType {
+    /// `1.`, `2.`, `3.`
+    Decimal,
+    /// `a.`, `b.`, `c.`
+    LowerAlpha,
+    /// `A.`, `B.`, `C.`
+    UpperAlpha,
+    /// `i.`, `ii.`, `iii.`
+    LowerRoman,
+    /// `I.`, `II.`, `III.`
+    UpperRoman,
+    /// A filled circle, drawn as Chromium draws CSS's `disc`.
+    Disc,
+    /// A hollow circle, drawn as Chromium draws CSS's `circle`.
+    Circle,
+    /// A filled square, drawn as Chromium draws CSS's `square`.
+    Square,
+    /// The same symbol before every item, such as `•`.
+    Symbol(SharedString),
+}
+
+impl ListStyleType {
+    /// The marker of the item numbered `ordinal`, with no space after it.
+    pub fn marker(&self, ordinal: u32) -> SharedString {
+        let letter = |base: u8| {
+            let ix = ordinal.saturating_sub(1) % 26;
+            char::from(base + ix as u8)
+        };
+        match self {
+            Self::Decimal => format!("{ordinal}.").into(),
+            Self::LowerAlpha => format!("{}.", letter(b'a')).into(),
+            Self::UpperAlpha => format!("{}.", letter(b'A')).into(),
+            Self::LowerRoman => format!("{}.", roman(ordinal)).into(),
+            Self::UpperRoman => format!("{}.", roman(ordinal).to_uppercase()).into(),
+            Self::Disc => "•".into(),
+            Self::Circle => "◦".into(),
+            Self::Square => "▪".into(),
+            Self::Symbol(symbol) => symbol.clone(),
+        }
+    }
+}
+
+/// `ordinal` in lower-case Roman numerals, or in decimal outside 1 to 3999
+/// as CSS falls back.
+fn roman(ordinal: u32) -> String {
+    if !(1..4000).contains(&ordinal) {
+        return ordinal.to_string();
+    }
+    const NUMERALS: [(u32, &str); 13] = [
+        (1000, "m"),
+        (900, "cm"),
+        (500, "d"),
+        (400, "cd"),
+        (100, "c"),
+        (90, "xc"),
+        (50, "l"),
+        (40, "xl"),
+        (10, "x"),
+        (9, "ix"),
+        (5, "v"),
+        (4, "iv"),
+        (1, "i"),
+    ];
+    let mut rest = ordinal;
+    let mut out = String::new();
+    for (value, numeral) in NUMERALS {
+        while rest >= value {
+            out.push_str(numeral);
+            rest -= value;
+        }
+    }
+    out
 }
 

+/// Numbers every defined footnote by its first reference, writing the number into each
+/// reference's label and clearing the label of a reference to no definition; returns the
+/// identifiers in number order.
+fn footnote_numbers(children: &mut [Node]) -> Vec<String> {
+    fn defined(nodes: &[Node], into: &mut Vec<String>) {
+        for node in nodes {
+            if let Node::FootnoteDefinition(def) = node {
+                into.push(def.identifier.clone());
+            }
+            if let Some(children) = node.children() {
+                defined(children, into);
+            }
+        }
+    }
+    fn number(nodes: &mut [Node], defined: &[String], order: &mut Vec<String>) {
+        for node in nodes {
+            if let Node::FootnoteReference(foot) = node {
+                foot.label = defined.contains(&foot.identifier).then(|| {
+                    let at = order.iter().position(|id| *id == foot.identifier).unwrap_or_else(|| {
+                        order.push(foot.identifier.clone());
+                        order.len() - 1
+                    });
+                    (at + 1).to_string()
+                });
+            }
+            if let Some(children) = node.children_mut() {
+                number(children, defined, order);
+            }
+        }
+    }
+    let mut ids = Vec::new();
+    defined(children, &mut ids);
+    let mut order = Vec::new();
+    number(children, &ids, &mut order);
+    order
+}
+
+/// The footnotes a document refers to, gathered at its end as a numbered list in the order
+/// of their numbers, each definition ending in its mark back; unreferenced ones are dropped.
+fn footnotes_section(
+    source: &str,
+    order: &[String],
+    mut definitions: Vec<mdast::FootnoteDefinition>,
+    cx: &mut NodeContext,
+) -> Option<BlockNode> {
+    let items: Vec<BlockNode> = order
+        .iter()
+        .filter_map(|id| {
+            let at = definitions.iter().position(|def| def.identifier == *id)?;
+            let def = definitions.swap_remove(at);
+            let span = new_span(def.position, cx);
+            let mut children: Vec<BlockNode> = def
+                .children
+                .into_iter()
+                .map(|c| ast_to_node(source, c, cx))
+                .collect();
+            let back = InlineNode::new("\u{21a9}").marks(vec![(
+                0.."\u{21a9}".len(),
+                TextMark {
+                    footnote: Some(node::FootnoteMark::Back),
+                    ..Default::default()
+                },
+            )]);
+            match children.last_mut() {
+                Some(BlockNode::Paragraph(paragraph)) => {
+                    paragraph.push(InlineNode::new(" "));
+                    paragraph.push(back);
+                }
+                _ => {
+                    let mut paragraph = Paragraph::default();
+                    paragraph.push(back);
+                    children.push(BlockNode::Paragraph(paragraph));
+                }
+            }
+            Some(BlockNode::ListItem {
+                children,
+                spread: false,
+                checked: None,
+                span,
+            })
+        })
+        .collect();
+    (!items.is_empty()).then(|| BlockNode::Blockquote {
+        children: vec![BlockNode::List {
+            children: items,
+            ordered: true,
+            start: Some(1),
+            span: None,
+        }],
+        span: None,
+        kind: node::QuoteKind::Footnotes,
+    })
+}

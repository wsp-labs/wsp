+/// What a code block draws around its code, returned by
+/// [`crate::text::TextView::code_block_chrome`] for each block.
+///
+/// The header and footer span the block inside its frame, above and below
+/// the code; the code keeps the padding `style.code_block` sets.
+pub struct CodeBlockChrome {
+    header: Option<AnyElement>,
+    footer: Option<AnyElement>,
+    wrap: bool,
+    scrollbar: Option<(Pixels, ScrollbarStyles)>,
+}
+
+impl Default for CodeBlockChrome {
+    fn default() -> Self {
+        Self {
+            header: None,
+            footer: None,
+            wrap: true,
+            scrollbar: None,
+        }
+    }
+}
+
+impl CodeBlockChrome {
+    /// Chrome with no header or footer, wrapping long lines.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Sets the row above the code.
+    pub fn header(mut self, header: impl IntoElement) -> Self {
+        self.header = Some(header.into_any_element());
+        self
+    }
+
+    /// Sets the row below the code.
+    pub fn footer(mut self, footer: impl IntoElement) -> Self {
+        self.footer = Some(footer.into_any_element());
+        self
+    }
+
+    /// Sets whether long lines wrap, default true. Unwrapped, the code
+    /// scrolls sideways.
+    pub fn wrap(mut self, wrap: bool) -> Self {
+        self.wrap = wrap;
+        self
+    }
+
+    /// Shows the unwrapped code's scrollbar at all times in a lane `lane`
+    /// high under the code, painted with `styles`, while the code is wider
+    /// than the block. Without it the scrollbar overlays the code and shows
+    /// while it scrolls.
+    pub fn scrollbar(mut self, lane: Pixels, styles: ScrollbarStyles) -> Self {
+        self.scrollbar = Some((lane, styles));
+        self
+    }
+}

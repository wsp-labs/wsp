+        options: &NodeRenderOptions,
+        style: &TextViewStyle,
+        window: &mut Window,
+        cx: &mut App,
+    ) -> AnyElement {
+        let mut frame = style.code_block().clone();
+        let mut padding = StyleRefinement::default().px_4().py(px(14.));
+        padding.padding.refine(&std::mem::take(&mut frame.padding));
+        let body = if chrome.wrap {
+            div()
+                .w_full()
+                .min_w_0()
+                .refine_style(&padding)
+                .child(code)
+                .into_any_element()
+        } else {
+            let scroll_handle = window
+                .use_keyed_state(
+                    block_element_id("codeblock-hscroll", self.span, options.ix),
+                    cx,
+                    |_, _| ScrollHandle::default(),
+                )
+                .read(cx)
+                .clone();
+            // Measured by the last frame, as the scrollbar's lane only shows
+            // while the code is wider than the block.
+            let overflows = scroll_handle.max_offset().x > px(0.);
+            let (lane, scrollbar) = match chrome.scrollbar {
+                Some((lane, styles)) => (
+                    lane,
+                    Scrollbar::horizontal(&scroll_handle)
+                        .mode(ScrollbarMode::Always)
+                        .styles(|_| styles),
+                ),
+                None => (px(0.), Scrollbar::horizontal(&scroll_handle)),
+            };
+            div()
+                .w_full()
+                .min_w_0()
+                .relative()
+                .when(overflows, |this| this.pb(lane))
+                .child(horizontal_scroll_area(

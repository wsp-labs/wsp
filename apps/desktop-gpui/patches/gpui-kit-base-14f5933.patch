+                    &padding.clone().flex(),
+                    div().flex_none().whitespace_nowrap().child(code),
+                ))
+                .when(overflows, |this| {
+                    this.child(div().absolute().inset_0().child(scrollbar))
+                })
+                // Draws again once this frame's layout says otherwise.
+                .child(
+                    gpui::canvas(
+                        |_, _, _| {},
+                        move |_, _, window, cx| {

+/// The room a code span's frame leaves on each side of its text: the style's,
+/// or the default for a span whose highlight carries no frame.
+pub(super) fn code_padding(highlights: &[(Range<usize>, InlineHighlight)]) -> Pixels {
+    highlights
+        .iter()
+        .find(|(_, highlight)| highlight.font_size_scale.is_some())
+        .map_or(Pixels::ZERO, |(_, highlight)| {

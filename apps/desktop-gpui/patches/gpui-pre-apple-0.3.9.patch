+    /// Copies the region out of the target and blurs it at the pass's scale, returning the pass
+    /// and the texture holding the result in its scaled size.
+    fn blur_backdrop(
+        &mut self,
+        blur: &BackdropBlur,
+        region: Bounds<DevicePixels>,
+        texture: &metal::TextureRef,
+        command_buffer: &metal::CommandBufferRef,
+    ) -> (BackdropBlurPass, metal::Texture) {
+        let (width, height) = (region.size.width.0 as u32, region.size.height.0 as u32);
+        let mut scale = 1u32;
+        while blur.blur_radius.0 > BACKDROP_BLUR_MAX_SIGMA * scale as f32
+            && scale < width.max(height)
+        {
+            scale *= 2;
+        }
+        let scaled_size = size(
+            DevicePixels(width.div_ceil(scale) as i32),
+            DevicePixels(height.div_ceil(scale) as i32),
+        );
+        let mut taps = [[0.; 2]; BACKDROP_BLUR_MAX_TAPS];
+        let tap_count = backdrop_blur_taps(blur.blur_radius.0 / scale as f32, &mut taps);
+        let blur_pass = BackdropBlurPass {
+            region: backdrop_blur_region_bounds(region),
+            scaled_size: size(
+                ScaledPixels(scaled_size.width.0 as f32),
+                ScaledPixels(scaled_size.height.0 as f32),
+            ),
+            scale: scale as f32,
+            tap_count,
+            taps,
+        };
+        let mut textures = self.backdrop_blur_textures(region.size);
+
+        let blit = command_buffer.new_blit_command_encoder();
+        blit.copy_from_texture(
+            texture,
+            0,
+            0,
+            metal::MTLOrigin {
+                x: region.origin.x.0 as u64,
+                y: region.origin.y.0 as u64,
+                z: 0,
+            },
+            metal::MTLSize {
+                width: width as u64,
+                height: height as u64,
+                depth: 1,
+            },
+            &textures[0],
+            0,
+            0,
+            metal::MTLOrigin { x: 0, y: 0, z: 0 },
+        );
+        blit.end_encoding();
+
+        let downsample = (scale > 1).then_some(&self.backdrop_blur_downsample_pipeline_state);
+        let blur_passes = (tap_count > 1).then_some([
+            &self.backdrop_blur_horizontal_pipeline_state,
+            &self.backdrop_blur_vertical_pipeline_state,
+        ]);
+        for pipeline_state in downsample
+            .into_iter()
+            .chain(blur_passes.into_iter().flatten())
+        {
+            let command_encoder = new_command_encoder_for_texture(
+                command_buffer,
+                &textures[1],
+                scaled_size,
+                Some(metal::MTLClearColor::new(0., 0., 0., 0.)),
+            );
+            command_encoder.set_render_pipeline_state(pipeline_state);
+            command_encoder.set_vertex_buffer(
+                BackdropBlurInputIndex::Vertices as u64,
+                Some(&self.unit_vertices),
+                0,
+            );
+            command_encoder.set_fragment_bytes(
+                BackdropBlurInputIndex::Pass as u64,
+                mem::size_of_val(&blur_pass) as u64,
+                &blur_pass as *const BackdropBlurPass as *const _,
+            );
+            command_encoder
+                .set_fragment_texture(BackdropBlurInputIndex::Texture as u64, Some(&textures[0]));
+            command_encoder.draw_primitives(metal::MTLPrimitiveType::Triangle, 0, 6);
+            command_encoder.end_encoding();
+            textures.swap(0, 1);
+        }
+
+        let [blurred_texture, _] = textures;
+        (blur_pass, blurred_texture)
+    }
+
+    fn composite_backdrop_blur(
+        &self,
+        blur: &BackdropBlur,
+        blur_pass: &BackdropBlurPass,
+        blurred_texture: &metal::TextureRef,
+        viewport_size: Size<DevicePixels>,
+        command_encoder: &metal::RenderCommandEncoderRef,
+    ) {
+        command_encoder.set_render_pipeline_state(&self.backdrop_blur_composite_pipeline_state);
+        command_encoder.set_vertex_buffer(
+            BackdropBlurInputIndex::Vertices as u64,
+            Some(&self.unit_vertices),
+            0,
+        );
+        command_encoder.set_vertex_bytes(
+            BackdropBlurInputIndex::BackdropBlur as u64,
+            mem::size_of_val(blur) as u64,
+            blur as *const BackdropBlur as *const _,
+        );
+        command_encoder.set_fragment_bytes(
+            BackdropBlurInputIndex::BackdropBlur as u64,
+            mem::size_of_val(blur) as u64,
+            blur as *const BackdropBlur as *const _,
+        );
+        command_encoder.set_vertex_bytes(
+            BackdropBlurInputIndex::Pass as u64,
+            mem::size_of_val(blur_pass) as u64,
+            blur_pass as *const BackdropBlurPass as *const _,
+        );
+        command_encoder.set_fragment_bytes(
+            BackdropBlurInputIndex::Pass as u64,
+            mem::size_of_val(blur_pass) as u64,
+            blur_pass as *const BackdropBlurPass as *const _,
+        );
+        command_encoder.set_vertex_bytes(
+            BackdropBlurInputIndex::ViewportSize as u64,
+            mem::size_of_val(&viewport_size) as u64,
+            &viewport_size as *const Size<DevicePixels> as *const _,
+        );
+        command_encoder.set_fragment_texture(
+            BackdropBlurInputIndex::Texture as u64,
+            Some(blurred_texture),
+        );
+        command_encoder.draw_primitives(metal::MTLPrimitiveType::Triangle, 0, 6);
+    }
+
+    fn backdrop_blur_textures(&mut self, size: Size<DevicePixels>) -> [metal::Texture; 2] {
+        let (width, height) = self
+            .backdrop_blur_textures
+            .as_ref()
+            .map_or((0, 0), |[texture, _]| (texture.width(), texture.height()));
+        if width < size.width.0 as u64 || height < size.height.0 as u64 {
+            let texture_descriptor = metal::TextureDescriptor::new();
+            texture_descriptor.set_width(width.max(size.width.0 as u64));
+            texture_descriptor.set_height(height.max(size.height.0 as u64));
+            texture_descriptor.set_pixel_format(MTLPixelFormat::BGRA8Unorm);
+            texture_descriptor.set_storage_mode(metal::MTLStorageMode::Private);
+            texture_descriptor.set_usage(
+                metal::MTLTextureUsage::RenderTarget | metal::MTLTextureUsage::ShaderRead,
+            );
+            self.backdrop_blur_textures = Some([
+                self.device.new_texture(&texture_descriptor),
+                self.device.new_texture(&texture_descriptor),
+            ]);
+        }
+        self.backdrop_blur_textures
+            .clone()
+            .expect("just ensured the backdrop blur textures exist")
+    }
+}
+
+fn backdrop_blur_region(
+    blur: &BackdropBlur,
+    texture: &metal::TextureRef,
+) -> Option<Bounds<DevicePixels>> {
+    let bounds = blur.bounds;
+    let left = (bounds.origin.x.0.floor() as i32).max(0);
+    let top = (bounds.origin.y.0.floor() as i32).max(0);
+    let right = (bounds.right().0.ceil() as i32).min(texture.width() as i32);
+    let bottom = (bounds.bottom().0.ceil() as i32).min(texture.height() as i32);
+    (right > left && bottom > top).then(|| {
+        Bounds::from_corners(
+            point(DevicePixels(left), DevicePixels(top)),
+            point(DevicePixels(right), DevicePixels(bottom)),
+        )
+    })
+}
+
+fn backdrop_blur_region_bounds(region: Bounds<DevicePixels>) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(
+            ScaledPixels(region.origin.x.0 as f32),
+            ScaledPixels(region.origin.y.0 as f32),
+        ),
+        size: size(
+            ScaledPixels(region.size.width.0 as f32),
+            ScaledPixels(region.size.height.0 as f32),
+        ),
+    }
+}
+
+/// Fills `taps` with a normalized Gaussian of standard deviation `sigma` reaching ceil(3 sigma)
+/// pixels each way, as (offset, weight): the center, then one bilinear sample per two neighboring
+/// pixels. Returns the tap count.
+fn backdrop_blur_taps(sigma: f32, taps: &mut [[f32; 2]; BACKDROP_BLUR_MAX_TAPS]) -> u32 {
+    let radius = ((3.0 * sigma).ceil().max(0.0) as usize).min(2 * (BACKDROP_BLUR_MAX_TAPS - 1));
+    let weight = |offset: usize| (-((offset * offset) as f32) / (2.0 * sigma * sigma)).exp();
+    let total = 1.0 + 2.0 * (1..=radius).map(weight).sum::<f32>();
+    taps[0] = [0.0, 1.0 / total];
+    let mut count = 1;
+    for near in (1..=radius).step_by(2) {
+        let near_weight = weight(near);
+        let far_weight = if near < radius { weight(near + 1) } else { 0.0 };
+        let pair_weight = near_weight + far_weight;
+        if pair_weight == 0.0 {
+            break;
+        }
+        let offset = (near as f32 * near_weight + (near + 1) as f32 * far_weight) / pair_weight;
+        taps[count] = [offset, pair_weight / total];
+        count += 1;
+    }
+    count as u32
+}

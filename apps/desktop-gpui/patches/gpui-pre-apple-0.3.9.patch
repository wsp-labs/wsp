+
+    fn backdrop_blur_textures(
+        &mut self,
+        size: Size<DevicePixels>,
+    ) -> (metal::Texture, metal::Texture) {
+        let (width, height) = self
+            .backdrop_blur_textures
+            .as_ref()
+            .map_or((0, 0), |(texture, _)| (texture.width(), texture.height()));
+        if width < size.width.0 as u64 || height < size.height.0 as u64 {
+            let texture_descriptor = metal::TextureDescriptor::new();
+            texture_descriptor.set_width(width.max(size.width.0 as u64));
+            texture_descriptor.set_height(height.max(size.height.0 as u64));
+            texture_descriptor.set_pixel_format(MTLPixelFormat::BGRA8Unorm);
+            texture_descriptor.set_storage_mode(metal::MTLStorageMode::Private);
+            texture_descriptor.set_usage(
+                metal::MTLTextureUsage::RenderTarget | metal::MTLTextureUsage::ShaderRead,
+            );
+            self.backdrop_blur_textures = Some((
+                self.device.new_texture(&texture_descriptor),
+                self.device.new_texture(&texture_descriptor),
+            ));
+        }
+        self.backdrop_blur_textures
+            .clone()
+            .expect("just ensured the backdrop blur textures exist")
+    }
+}
+
+fn backdrop_blur_region(
+    blur: &BackdropBlur,
+    texture: &metal::TextureRef,
+) -> Option<Bounds<DevicePixels>> {
+    let bounds = blur.bounds;
+    let left = (bounds.origin.x.0.round() as i32).max(0);
+    let top = (bounds.origin.y.0.round() as i32).max(0);
+    let right = (bounds.right().0.round() as i32).min(texture.width() as i32);
+    let bottom = (bounds.bottom().0.round() as i32).min(texture.height() as i32);
+    (right > left && bottom > top).then(|| {
+        Bounds::from_corners(
+            point(DevicePixels(left), DevicePixels(top)),
+            point(DevicePixels(right), DevicePixels(bottom)),
+        )
+    })
+}
+
+fn backdrop_blur_region_bounds(region: Bounds<DevicePixels>) -> Bounds<ScaledPixels> {
+    Bounds {
+        origin: point(
+            ScaledPixels(region.origin.x.0 as f32),
+            ScaledPixels(region.origin.y.0 as f32),
+        ),
+        size: size(
+            ScaledPixels(region.size.width.0 as f32),
+            ScaledPixels(region.size.height.0 as f32),
+        ),
+    }
+}
+
+/// (offset, weight) of the center tap, then of each pair of neighboring taps merged into one linear sample.
+fn backdrop_blur_taps(sigma: f32) -> Vec<[f32; 2]> {
+    let radius = (3. * sigma).ceil().max(0.) as i32;
+    let weight = |x: i32| (-((x * x) as f32) / (2. * sigma * sigma)).exp();
+    let mut taps = vec![[0., 1.]];
+    let mut total = 1.;
+    for x in (1..=radius).step_by(2) {
+        let near = weight(x);
+        let far = if x < radius { weight(x + 1) } else { 0. };
+        taps.push([x as f32 + far / (near + far), near + far]);
+        total += 2. * (near + far);
+    }
+    for tap in &mut taps {
+        tap[1] /= total;
+    }
+    taps
 }
 

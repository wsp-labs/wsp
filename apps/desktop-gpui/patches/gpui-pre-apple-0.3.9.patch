+vertex BackdropBlurCompositeVertexOutput backdrop_blur_composite_vertex(
+    uint unit_vertex_id [[vertex_id]],
+    constant float2 *unit_vertices [[buffer(BackdropBlurInputIndex_Vertices)]],
+    constant BackdropBlur *blurs [[buffer(BackdropBlurInputIndex_BackdropBlur)]],
+    constant Size_DevicePixels *viewport_size
+    [[buffer(BackdropBlurInputIndex_ViewportSize)]],
+    constant Bounds_ScaledPixels *regions [[buffer(BackdropBlurInputIndex_Region)]]) {
+  float2 unit_vertex = unit_vertices[unit_vertex_id];
+  BackdropBlur blur = blurs[0];
+  Bounds_ScaledPixels region = regions[0];
+  float4 device_position = to_device_position(unit_vertex, region, viewport_size);
+  float4 clip_distance =
+      distance_from_clip_rect(unit_vertex, region, blur.content_mask.bounds);
+  return BackdropBlurCompositeVertexOutput{
+      device_position,
+      {clip_distance.x, clip_distance.y, clip_distance.z, clip_distance.w}};
+}
+
+fragment float4 backdrop_blur_composite_fragment(
+    BackdropBlurCompositeFragmentInput input [[stage_in]],
+    constant BackdropBlur *blurs [[buffer(BackdropBlurInputIndex_BackdropBlur)]],
+    constant Bounds_ScaledPixels *regions [[buffer(BackdropBlurInputIndex_Region)]],
+    constant float2 *taps [[buffer(BackdropBlurInputIndex_Taps)]],
+    constant uint *tap_count [[buffer(BackdropBlurInputIndex_TapCount)]],
+    texture2d<float> blurred [[texture(BackdropBlurInputIndex_Texture)]]) {
+  BackdropBlur blur = blurs[0];
+  Bounds_ScaledPixels region = regions[0];
+  float2 region_origin = float2(region.origin.x, region.origin.y);
+  float2 region_size = float2(region.size.width, region.size.height);
+  float4 color = blur_backdrop(blurred, input.position.xy - region_origin,
+                               float2(0., 1.), region_size, taps, tap_count[0]);
+
+  // feColorMatrix saturate, on the stored values; premultiplied, so clamped to alpha.

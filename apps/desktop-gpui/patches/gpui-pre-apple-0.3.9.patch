+struct BackdropBlurVertexOutput {
+  float4 position [[position]];
+};
+
+// Covers the viewport, which the renderer sets to the region's size in the
+// horizontal pass's target.
+vertex BackdropBlurVertexOutput backdrop_blur_vertex(
+    uint unit_vertex_id [[vertex_id]],
+    constant float2 *unit_vertices [[buffer(BackdropBlurInputIndex_Vertices)]]) {
+  float2 unit_vertex = unit_vertices[unit_vertex_id];
+  return BackdropBlurVertexOutput{
+      float4(unit_vertex * float2(2., -2.) + float2(-1., 1.), 0., 1.)};
+}
+
+fragment float4 backdrop_blur_fragment(
+    BackdropBlurVertexOutput input [[stage_in]],
+    constant Bounds_ScaledPixels *regions [[buffer(BackdropBlurInputIndex_Region)]],
+    constant float2 *taps [[buffer(BackdropBlurInputIndex_Taps)]],
+    constant uint *tap_count [[buffer(BackdropBlurInputIndex_TapCount)]],
+    texture2d<float> backdrop [[texture(BackdropBlurInputIndex_Texture)]]) {
+  Bounds_ScaledPixels region = regions[0];
+  float2 region_size = float2(region.size.width, region.size.height);
+  return blur_backdrop(backdrop, input.position.xy, float2(1., 0.), region_size,
+                       taps, tap_count[0]);
+}
+
+struct BackdropBlurCompositeVertexOutput {
+  float4 position [[position]];

    " pub struct Pane {",
    "     title: String,",
    "     checks: Vec<Check>,",
    "+    behind: Option<u64>,",
    " }",
    " ",
    " impl Pane {",
    "     pub fn read(&mut self, checks: Vec<Check>) {",
    "+        let failed = checks.iter().filter(|c| c.failed()).count();",
    "+        if failed > 0 {",
    "+            self.title = format!(\"{failed} failing\");",
    "+        }",
    "         self.checks = checks;",
    "+        self.behind = None;",
    "     }",
    " ",
    "     pub fn title(&self) -> &str {",

@@ -0,0 +1,10 @@
+/// Clamps `value` into `low..=high`.
+pub fn clamp(value: f64, low: f64, high: f64) -> f64 {
+    if value < low {
+        low
+    } else if value > high {
+        high
+    } else {
+        value
+    }
+}

    <row>
      <status tone="warning">Waiting on a reviewer who has been away for the whole of this week</status>
      <chip>feature/a-very-long-branch-name-that-does-not-fit</chip>
    </row>
    <empty title="No pull request yet for this branch, which has been open for a long time">Push the branch and open one from the pull request pane when the tests pass.</empty>
